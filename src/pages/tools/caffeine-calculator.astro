---
/**
 * Caffeine Calculator Page
 *
 * Track daily caffeine intake and understand caffeine content.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import CaffeineCalculator from '../../components/tools/CaffeineCalculator';
---

<BaseLayout
  title="Caffeine Calculator | Track Your Daily Intake"
  description="Track your daily caffeine consumption and stay within healthy limits. See caffeine content in coffee, tea, energy drinks, soda, and more."
  keywords={['caffeine calculator', 'caffeine tracker', 'caffeine content', 'coffee caffeine', 'daily caffeine limit', 'caffeine in drinks']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Caffeine Calculator', url: '/tools/caffeine-calculator' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Caffeine Calculator</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Caffeine <span class="text-accent text-[var(--color-wine)]">Calculator</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Track your daily caffeine intake and stay within healthy limits. See how much caffeine
          is in your favorite beverages and understand its effects on your body.
        </p>
      </div>
    </div>
  </section>

  <!-- Calculator Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <CaffeineCalculator client:load />
    </div>
  </section>

  <!-- Educational Content -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Caffeine
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          <div class="p-5 bg-green-50 rounded-xl border border-green-200">
            <h3 class="font-display text-lg font-semibold text-green-800 mb-2">
              Benefits (in moderation)
            </h3>
            <ul class="text-sm text-[var(--text-secondary)] space-y-1 list-disc list-inside">
              <li>Increased alertness and focus</li>
              <li>Improved physical performance</li>
              <li>Enhanced mood and cognitive function</li>
              <li>May reduce risk of certain diseases</li>
            </ul>
          </div>

          <div class="p-5 bg-red-50 rounded-xl border border-red-200">
            <h3 class="font-display text-lg font-semibold text-red-800 mb-2">
              Side Effects (excess)
            </h3>
            <ul class="text-sm text-[var(--text-secondary)] space-y-1 list-disc list-inside">
              <li>Anxiety and restlessness</li>
              <li>Sleep disruption and insomnia</li>
              <li>Increased heart rate</li>
              <li>Digestive issues</li>
            </ul>
          </div>

          <div class="p-5 bg-amber-50 rounded-xl border border-amber-200">
            <h3 class="font-display text-lg font-semibold text-amber-800 mb-2">
              Daily Limits
            </h3>
            <ul class="text-sm text-[var(--text-secondary)] space-y-1">
              <li><strong>Adults:</strong> Up to 400mg/day (FDA)</li>
              <li><strong>Pregnant:</strong> 200mg or less</li>
              <li><strong>Teens:</strong> 100mg or less</li>
              <li><strong>Children:</strong> Avoid caffeine</li>
            </ul>
          </div>

          <div class="p-5 bg-blue-50 rounded-xl border border-blue-200">
            <h3 class="font-display text-lg font-semibold text-blue-800 mb-2">
              Sleep Tips
            </h3>
            <ul class="text-sm text-[var(--text-secondary)] space-y-1 list-disc list-inside">
              <li>Stop caffeine 6-8 hours before bed</li>
              <li>Avoid afternoon coffee if sensitive</li>
              <li>Consider switching to decaf after noon</li>
              <li>Watch hidden sources (chocolate, some meds)</li>
            </ul>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Health Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/protein-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-red-100 flex items-center justify-center text-2xl">
            🥩
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Protein Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Daily protein needs</p>
          </div>
        </a>

        <a href="/tools/macro-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-2xl">
            📊
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Macro Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Balance your macros</p>
          </div>
        </a>

        <a href="/tools/coffee-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-2xl">
            ☕
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Coffee & Dessert Pairing</h4>
            <p class="text-sm text-[var(--text-muted)]">Perfect pairings</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Caffeine Calculator | Track Your Daily Intake",
  "description": "Track your daily caffeine consumption and stay within healthy limits. See caffeine content in coffee, tea, energy drinks, soda, and more.",
  "url": "https://pairdish.com/tools/caffeine-calculator",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
