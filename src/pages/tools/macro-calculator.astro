---
/**
 * Macro Balance Calculator Tool Page
 *
 * Calculate ideal macronutrient ratios for various goals.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import MacroCalculator from '../../components/tools/MacroCalculator';
---

<BaseLayout
  title="Macro Balance Calculator"
  description="Calculate macronutrient ratios for your goals: protein, carb and fat targets in grams for keto, low-carb, high-protein and balanced diets."
  keywords={['macro calculator', 'macronutrient calculator', 'keto macros', 'IIFYM', 'flexible dieting', 'carb calculator', 'protein fat carbs']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Macro Balance Calculator', url: '/tools/macro-calculator' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Macro Calculator</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Macro Balance <span class="text-accent text-[var(--color-wine)]">Calculator</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Calculate your ideal macronutrient ratios based on your body stats and fitness goals.
          Choose from popular diet presets or customize your own ratio.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <MacroCalculator client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Macronutrients
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              TDEE Explained
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Total Daily Energy Expenditure (TDEE) is how many calories you burn daily including
              exercise. Eat below TDEE to lose weight, above to gain. We calculate using the
              Mifflin-St Jeor equation.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Flexible Dieting (IIFYM)
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              "If It Fits Your Macros" is a flexible approach where any food is allowed as long
              as it fits your daily macro targets. It promotes sustainability over restriction.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Popular Macro Splits
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <span class="block font-bold text-blue-700 text-sm">Balanced</span>
            <span class="block text-xs text-blue-600 mt-1">25/50/25 (P/C/F)</span>
          </div>
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block font-bold text-green-700 text-sm">Keto</span>
            <span class="block text-xs text-green-600 mt-1">20/5/75 (P/C/F)</span>
          </div>
          <div class="text-center p-4 bg-red-50 rounded-lg">
            <span class="block font-bold text-red-700 text-sm">High Protein</span>
            <span class="block text-xs text-red-600 mt-1">40/35/25 (P/C/F)</span>
          </div>
          <div class="text-center p-4 bg-purple-50 rounded-lg">
            <span class="block font-bold text-purple-700 text-sm">Zone Diet</span>
            <span class="block text-xs text-purple-600 mt-1">30/40/30 (P/C/F)</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block font-bold text-orange-700 text-sm">Low Carb</span>
            <span class="block text-xs text-orange-600 mt-1">30/30/40 (P/C/F)</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block font-bold text-amber-700 text-sm">Mediterranean</span>
            <span class="block text-xs text-amber-600 mt-1">20/45/35 (P/C/F)</span>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Macro balancing: calorie factors + percentage-to-grams math -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        The Macro Balancing Math Behind the Percentages
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        A macro split is only half a plan. The percentages say how the day&rsquo;s calories are
        divided; they say nothing about how many grams of each nutrient that works out to, and the
        grams are the number you actually weigh. The conversion depends on how much energy a gram of
        each macronutrient carries &mdash; and those figures are not a fitness-app convention. They
        are the general factors the U.S. Food and Drug Administration uses to calculate the calorie
        content printed on a nutrition label.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Calorie factors used for U.S. nutrition labelling (21 CFR 101.9(c)(1)(i)).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Nutrient</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Calories per gram</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">What it means on a 2,000-calorie day</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Protein</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">4</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">100 g is 400 calories &mdash; a fifth of the day from a food you may think of
                as &ldquo;free&rdquo;.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Total carbohydrate</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">4</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">The same 4 as protein, which is why a high-carb day fills up fast.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Total fat</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">9</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">One gram of fat carries as much energy as 2.25 grams of protein or
                carbohydrate.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Soluble non-digestible carbohydrate (fibre)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">2</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Counted at half rate, not the full 4.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sugar alcohols</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">0 to 3</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Isomalt and lactitol 2.0, xylitol 2.4, maltitol 2.1, sorbitol 2.6,
                hydrogenated starch hydrolysates 3.0, mannitol 1.6, erythritol 0.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        From a percentage to grams
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Multiply the calorie target by the percentage for that macro, then divide by its factor
        &mdash; 4 for protein and carbohydrate, 9 for fat. A 2,000-calorie day at 40% protein,
        35% carbohydrate and 25% fat becomes 2,000 &times; 0.40 &divide; 4 = 200 g of protein,
        2,000 &times; 0.35 &divide; 4 = 175 g of carbohydrate and 2,000 &times; 0.25 &divide; 9 =
        56 g of fat.
      </p>
      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Four common splits converted to grams at 2,000 calories.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Split (protein / carbohydrate / fat)</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Protein</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Carbohydrate</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Fat</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Balanced 25 / 50 / 25</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">125 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">250 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">56 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">High protein 40 / 35 / 25</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">200 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">175 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">56 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Low carb 30 / 30 / 40</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">150 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">150 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">89 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Ketogenic 20 / 5 / 75</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">100 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">25 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">167 g</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-10">
        Run the arithmetic back the other way and the rounding shows up. The balanced row is
        125 &times; 4 + 250 &times; 4 + 56 &times; 9 = 2,004 calories, not 2,000. That gap is the
        reason a plan can be built exactly to its percentages and still miss the calorie target by a
        few calories a day.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        Why the totals never land exactly
      </h3>
      <ul class="list-disc pl-6 space-y-2 text-[var(--text-secondary)] text-base leading-relaxed mb-10">
        <li>Grams are rounded to whole numbers and the calories they carry are not. The imbalance is
          always small, but it is always there.</li>
        <li>Fibre sits inside the carbohydrate total and is counted at 2 calories per gram, so a
          high-fibre day delivers less energy than the plain 4-per-gram arithmetic predicts.</li>
        <li>Sugar alcohols in protein bars and reduced-sugar sweets run from 0 to 3 calories per
          gram, so two bars with the same protein figure can carry very different calorie totals.</li>
        <li>Alcoholic drinks carry calories that no macro percentage accounts for. A drink on a
          training day is the usual reason the numbers will not reconcile.</li>
      </ul>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        Two official anchors to check a plan against
      </h3>
      <ul class="list-disc pl-6 space-y-2 text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        <li>The current Dietary Guidelines for Americans set a protein goal of <strong>1.2 to 1.6
          grams per kilogram of body weight per day</strong>, adjusted for calories. For a 70 kg
          adult that is 84 to 112 g &mdash; convert it per person with the
          <a href="/tools/protein-calculator" class="text-[var(--color-wine)] underline">protein calculator</a>.</li>
        <li>They set a ceiling rather than a target for added sugars: no single meal should contain
          more than 10 grams. Check what the sweetener in a recipe contributes with the
          <a href="/tools/sugar-substitution" class="text-[var(--color-wine)] underline">sugar substitution tool</a>.</li>
        <li>Saturated fat should not exceed 10% of total daily calories &mdash; about 22 g on a
          2,000-calorie day. Because fat carries 9 calories per gram, that ceiling arrives sooner
          than most people expect.</li>
      </ul>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: <a href="https://www.ecfr.gov/current/title-21/chapter-I/subchapter-B/part-101/subpart-A/section-101.9" rel="noopener" class="text-[var(--color-wine)] underline">21 CFR 101.9(c)(1)(i), &ldquo;Nutrition labelling of food&rdquo; (calorie factors)</a>;
        <a href="https://cdn.realfood.gov/DGA.pdf" rel="noopener" class="text-[var(--color-wine)] underline">USDA Food and Nutrition Service, <em>Dietary Guidelines for Americans, 2025&ndash;2030</em></a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Health Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/protein-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-red-100 flex items-center justify-center text-red-700">
            💪
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Protein Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Track protein intake</p>
          </div>
        </a>

        <a href="/tools/nutrition-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.27 21.7s9.87-3.5 12.73-6.36a4.5 4.5 0 0 0-6.36-6.37C5.77 11.84 2.27 21.7 2.27 21.7z"/>
              <path d="M22 9s-1.33-2-3.5-2C16.86 7 15 9 15 9s1.33 2 3.5 2S22 9 22 9z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Nutrition Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Full nutritional breakdown</p>
          </div>
        </a>

        <a href="/tools/dietary-finder" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center text-teal-700">
            🥗
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Dietary Meal Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Meals for your diet</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Guides
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <a href="/articles/meal-planning-with-macros" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-700">
            📐
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Meal Planning With Macros</h4>
            <p class="text-sm text-[var(--text-muted)]">A simple weekly system around your targets.</p>
          </div>
        </a>

        <a href="/articles/high-protein-meal-prep" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-red-100 flex items-center justify-center text-red-700">
            💪
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">High-Protein Meal Prep</h4>
            <p class="text-sm text-[var(--text-muted)]">Flexible prep that doesn’t feel like diet food.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
