---
/**
 * Drink/Cocktail Calculator Tool Page
 *
 * Interactive tool for calculating beverage quantities for parties and events.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import DrinkCalculator from '../../components/tools/DrinkCalculator';
---

<BaseLayout
  title="Drink & Cocktail Calculator"
  description="Calculate exactly how much beer, wine, spirits, and mixers you need for your party. Plus batch cocktail scaling for easy entertaining."
  keywords={['drink calculator', 'party drink calculator', 'how much alcohol for party', 'cocktail calculator', 'batch cocktail recipe', 'bar calculator']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Drink & Cocktail Calculator', url: '/tools/drink-calculator' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Drink Calculator</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Drink & <span class="text-accent text-[var(--color-wine)]">Cocktail Calculator</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Never run out of drinks at your party. Calculate beer, wine, spirits, and mixer
          quantities, plus scale up your favorite cocktail recipes for batch mixing.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <DrinkCalculator client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          How to Plan Drinks for Any Event
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              The Basic Formula
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Plan for 1-2 drinks per person per hour. A typical 4-hour party needs about
              6-8 drinks per guest. Our calculator adjusts based on your event type—casual
              BBQs trend higher, formal dinners trend lower.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              The Right Mix
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              A typical party bar splits roughly: 40% beer, 30% wine, 20% spirits, 10%
              non-alcoholic. Adjust based on your crowd—wine lovers, beer enthusiasts,
              or cocktail connoisseurs will shift these ratios.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Drink Serving Guidelines
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-10">
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block text-3xl mb-2">🍺</span>
            <span class="text-sm font-medium text-amber-800">Beer</span>
            <p class="text-xs text-[var(--text-muted)] mt-1">1 bottle = 1 serving</p>
          </div>
          <div class="text-center p-4 bg-[var(--color-wine-glow)] rounded-lg">
            <span class="block text-3xl mb-2">🍷</span>
            <span class="text-sm font-medium text-[var(--color-wine)]">Wine</span>
            <p class="text-xs text-[var(--text-muted)] mt-1">1 bottle = 5 glasses</p>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block text-3xl mb-2">🥃</span>
            <span class="text-sm font-medium text-orange-800">Spirits</span>
            <p class="text-xs text-[var(--text-muted)] mt-1">1 bottle = 17 cocktails</p>
          </div>
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block text-3xl mb-2">🧊</span>
            <span class="text-sm font-medium text-green-800">Ice</span>
            <p class="text-xs text-[var(--text-muted)] mt-1">1 lb per guest</p>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Standard-drink math + non-alcoholic beverage planning -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        What Counts as One Drink &mdash; and Why the Bottle Count Lies
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The calculator above works in servings. A serving is not a fixed amount of alcohol, and
        that is where most party bars go wrong: the same twelve-ounce bottle is one drink or two
        depending only on what is inside it. U.S. health agencies settle the definition the way a
        bar measures a pour &mdash; a standard drink contains about 0.6 fluid ounces, or 14 grams,
        of pure alcohol &mdash; and then translate that into the glass sizes people actually use.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            One U.S. standard drink, by beverage (NIAAA; CDC).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Beverage</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Standard serving</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Alcohol by volume</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Why it matters when you buy</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Regular beer</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12 fl oz</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">5%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">The reference case: one bottle, one standard drink.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Malt liquor or hard seltzer</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">8 to 10 fl oz</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">7%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">More alcohol per ounce, so the standard serving is a smaller pour.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Table wine</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">5 fl oz</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">A restaurant pour, not a full mug &mdash; the five-glasses-per-bottle
                figure comes from this measure.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Distilled spirits (gin, rum, vodka, whiskey)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1.5 fl oz</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">40% (80 proof)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">The shot measure most cocktail recipes assume.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-10">
        Mixers change the volume of a drink, not the alcohol in it. A cocktail built on
        1.5 fl oz of spirits and topped with four ounces of juice, soda or sour mix is still one
        standard drink; it simply takes longer to drink. That is the arithmetic your calculator is
        already doing at the guest level, and it is the arithmetic you need at the shopping level
        too.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[720px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Standard drinks in the containers people actually buy (1 fl oz = 29.57 mL; the
            arithmetic is shown so you can redo it for any bottle).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Container</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Volume</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">ABV</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Standard drinks</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">The arithmetic</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Beer can or bottle</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12 fl oz</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">5%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12 &times; 0.05 &divide; 0.6 = 1.0</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Craft or imperial beer, same can</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12 fl oz</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">10%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">2</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12 &times; 0.10 &divide; 0.6 = 2.0</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Beer pint glass</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">16 fl oz</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">5%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 1 1/3</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">16 &times; 0.05 &divide; 0.6 = 1.3</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Wine bottle</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">750 mL (25.4 fl oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 5</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">25.4 &times; 0.12 &divide; 0.6 = 5.1</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Large-format wine bottle</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1.5 L (50.7 fl oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 10</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">50.7 &times; 0.12 &divide; 0.6 = 10.1</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Spirits bottle (a fifth)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">750 mL (25.4 fl oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">40%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 17</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">25.4 &times; 0.40 &divide; 0.6 = 16.9</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Spirits bottle (a handle)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1.75 L (59.2 fl oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">40%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 39</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">59.2 &times; 0.40 &divide; 0.6 = 39.5</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-10">
        Read the two tables together and the shopping list writes itself: divide the servings the
        calculator gives you for wine by 5 and you have bottles, divide the spirits servings by 17
        and you have fifths. Size the food side of the same event with the
        <a href="/tools/appetizer-planner" class="text-[var(--color-wine)] underline">appetizer planner</a>, and check the whole
        menu still adds up with the
        <a href="/tools/party-calculator" class="text-[var(--color-wine)] underline">party food calculator</a>.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Non-alcoholic drinks need their own count
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Coffee, tea and soda are the drinks most hosts under-buy, because they are planned as an
        afterthought to the bar. Michigan State University Extension publishes percentages of
        attendance for each, split by the makeup of the group and by whether the break falls in
        the morning or the afternoon. Multiply the percentage by your guest count to get cups,
        then divide by 20 (the number of eight-ounce cups in a gallon) to get gallons &mdash; and
        round each partial gallon up to the next half gallon.
      </p>
      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[720px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Beverage planning, as a percentage of attendance (Michigan State University
            Extension).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Beverage</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Morning break: all-male / all-female / mixed</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Afternoon break: all-male / all-female / mixed</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Regular coffee</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">60% / 50% / 55%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">35% / 30% / 35%</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Decaf coffee</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">20% / 25% / 25%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">20% / 20% / 20%</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tea</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">10% / 15% / 10%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">10% / 15% / 10%</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Soda</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">25% / 25% / 25%</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">70% / 70% / 70%</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Worked once: 300 guests at a mixed morning break means 300 &times; 55% = 165 cups of
        regular coffee, which is 165 &divide; 20 = 8.25 gallons, rounded up to 8.5 gallons. The
        same 300 guests take 75 cups of tea and 75 sodas on that break, and 210 sodas if the break
        falls in the afternoon. The same guidance sizes the bar itself at one bar and bartender per
        75 guests for a hosted bar and per 100 for a cash bar, and suggests opening the bars
        furthest from the entrance first so the queue does not bottleneck at the door.
      </p>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        One caution that has nothing to do with quantities: the amount of alcohol a person drinks
        affects their health, and U.S. health agencies publish the standard-drink definitions used
        above so that count is possible. If you are buying for a mixed group, plan the alcohol-free
        share first, then let the alcohol count fall out of it &mdash; the
        <a href="/tools/buffet-planner" class="text-[var(--color-wine)] underline">buffet planner</a> covers the food side of the same
        event.
      </p>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: <a href="https://www.niaaa.nih.gov/alcohols-effects-health/what-standard-drink" rel="noopener" class="text-[var(--color-wine)] underline">National Institute on Alcohol Abuse and Alcoholism, &ldquo;What Is A Standard Drink?&rdquo;</a>;
        <a href="https://www.cdc.gov/alcohol/standard-drink-sizes/index.html" rel="noopener" class="text-[var(--color-wine)] underline">U.S. Centers for Disease Control and Prevention, &ldquo;About Standard Drink Sizes&rdquo;</a>;
        <a href="https://www.canr.msu.edu/eventservices/uploads/files/Food%20&amp;%20Beverage%20Planning%20Tips.pdf" rel="noopener" class="text-[var(--color-wine)] underline">Michigan State University Extension, &ldquo;Food &amp; Beverage Planning Tips&rdquo; (PDF)</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/appetizer-planner" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center text-orange-700">
            🍢
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Appetizer Planner</h4>
            <p class="text-sm text-[var(--text-muted)]">Starter quantities</p>
          </div>
        </a>

        <a href="/tools/party-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🎉
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Party Food Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Food quantities</p>
          </div>
        </a>

        <a href="/tools/potluck-coordinator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            🥘
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Potluck Coordinator</h4>
            <p class="text-sm text-[var(--text-muted)]">Organize dishes</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
