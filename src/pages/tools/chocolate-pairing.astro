  "description": "Discover perfect pairings for dark, milk, white, and specialty chocolates. Match chocolate with wines, cheeses, fruits, nuts, and beverages.",
  "url": "https://pairdish.com/tools/chocolate-pairing",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



