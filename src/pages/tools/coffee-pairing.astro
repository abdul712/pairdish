---
/**
 * Coffee & Dessert Pairing Guide Tool Page
 *
 * Match coffee roasts with desserts and pastries.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import CoffeePairing from '../../components/tools/CoffeePairing';
---

<BaseLayout
  title="Coffee & Dessert Pairing Guide"
  description="Find the perfect dessert for your coffee. Match espresso, cappuccino, cold brew, and different roast levels with pastries, cakes, cookies, and chocolate."
  keywords={['coffee pairing', 'coffee and dessert', 'espresso dessert', 'coffee cake pairing', 'what dessert with coffee', 'coffee and chocolate', 'coffee roast pairing']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Coffee & Dessert Pairing Guide', url: '/tools/coffee-pairing' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Coffee Pairing</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Coffee & Dessert <span class="text-accent text-[var(--color-wine)]">Pairing Guide</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Discover the perfect dessert to complement your coffee. From light roasts with fruit tarts
          to espresso with tiramisu, find your ideal pairing.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <CoffeePairing client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          The Art of Coffee & Dessert Pairing
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Match the Roast
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Light roasts with delicate, fruity desserts. Medium roasts with caramel and nut
              flavors. Dark roasts with rich chocolate. The roast level guides the pairing.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Coffee & Chocolate
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Coffee and chocolate share over 300 flavor compounds, making them natural
              partners. The darker the chocolate, the darker the roast you can pair it with.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Classic Pairings by Coffee Type
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-stone-100 rounded-lg">
            <span class="block font-bold text-stone-700 text-sm">Espresso</span>
            <span class="block text-xs text-stone-600 mt-1">Biscotti, Tiramisu, Dark Chocolate</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block font-bold text-orange-700 text-sm">Cappuccino</span>
            <span class="block text-xs text-orange-600 mt-1">Croissants, Muffins, Scones</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block font-bold text-amber-700 text-sm">Cold Brew</span>
            <span class="block text-xs text-amber-600 mt-1">Brownies, Cheesecake, Ice Cream</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Pairing Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/chocolate-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-stone-100 flex items-center justify-center text-stone-700">
            🍫
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Chocolate Pairing</h4>
            <p class="text-sm text-[var(--text-muted)]">Sweet combinations</p>
          </div>
        </a>

        <a href="/tools/cheese-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-yellow-100 flex items-center justify-center text-yellow-700">
            🧀
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Cheese Pairing Guide</h4>
            <p class="text-sm text-[var(--text-muted)]">Perfect accompaniments</p>
          </div>
        </a>

        <a href="/tools/flavor-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-pink-100 flex items-center justify-center text-pink-700">
            ✨
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Flavor Pairing Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Discover flavor combos</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
