              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">200&nbsp;&deg;C</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">180&nbsp;&deg;C</td>
