            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">7</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">425&nbsp;&deg;F</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">220&nbsp;&deg;C</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">200&nbsp;&deg;C</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">High-heat roasting, pizza</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
