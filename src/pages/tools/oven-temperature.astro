---
/**
 * Oven Temperature Converter Tool Page
 *
 * Interactive tool for converting between Fahrenheit, Celsius, and Gas Mark.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import OvenTemperatureConverter from '../../components/tools/OvenTemperatureConverter';
---

<BaseLayout
  title="Oven Temperature Converter"
  description="Convert Fahrenheit, Celsius and gas mark, with the USDA safe minimum internal temperatures and a thermometer calibration check for your own oven."
  keywords={['oven temperature converter', 'fahrenheit to celsius', 'gas mark conversion', 'convection oven temperature', 'baking temperature chart']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Oven Temperature Converter', url: '/tools/oven-temperature' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Oven Temperature</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Oven <span class="text-accent text-[var(--color-wine)]">Temperature Converter</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Instantly convert between Fahrenheit, Celsius, and Gas Mark. Perfect for following
          international recipes or adjusting for convection ovens.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <OvenTemperatureConverter client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Oven Temperatures
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Why Different Scales?
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              The US uses Fahrenheit, most of the world uses Celsius, and the UK traditionally
              used Gas Marks (still common in older cookbooks). Knowing how to convert ensures
              your recipes work correctly regardless of origin.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Convection Adjustment
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Convection (fan) ovens circulate hot air, cooking food faster and more evenly.
              Reduce the temperature by 25&deg;F (15&deg;C) and check your food 25% sooner than the
              recipe suggests.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Temperature Categories
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-10">
          <div class="text-center p-3 bg-blue-50 rounded-lg">
            <span class="block text-lg font-bold text-blue-700">Low</span>
            <span class="text-xs text-[var(--text-muted)]">250-300&deg;F</span>
          </div>
          <div class="text-center p-3 bg-cyan-50 rounded-lg">
            <span class="block text-lg font-bold text-cyan-700">Moderate</span>
            <span class="text-xs text-[var(--text-muted)]">325-350&deg;F</span>
          </div>
          <div class="text-center p-3 bg-yellow-50 rounded-lg">
            <span class="block text-lg font-bold text-yellow-700">Mod. Hot</span>
            <span class="text-xs text-[var(--text-muted)]">375-400&deg;F</span>
          </div>
          <div class="text-center p-3 bg-orange-50 rounded-lg">
            <span class="block text-lg font-bold text-orange-700">Hot</span>
            <span class="text-xs text-[var(--text-muted)]">425-450&deg;F</span>
          </div>
          <div class="text-center p-3 bg-red-50 rounded-lg">
            <span class="block text-lg font-bold text-red-700">Very Hot</span>
            <span class="text-xs text-[var(--text-muted)]">475-500&deg;F</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Oven temperatures: the scales, the safety floor, and the calibration check -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        Oven Temperatures: What the Dial Means and What the Food Needs
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        An oven temperature does two separate jobs, and they fail in different ways. The first is
        browning, rising and texture, where a rough number is good enough and a scale conversion does
        the work. The second is killing bacteria, where the number is a published minimum measured
        inside the food, not on the dial. This page covers both, and then the part most recipes
        assume and never check: whether your oven actually reaches the temperature it claims.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Converting between Fahrenheit, Celsius and gas mark
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Fahrenheit and Celsius are exact conversions of each other: multiply Celsius by 9, divide by
        5 and add 32 to get Fahrenheit, or subtract 32 from Fahrenheit, multiply by 5 and divide by 9
        to get Celsius. Gas mark is not a conversion of that kind. It is a numbered scale printed on
        appliance dials, and the Fahrenheit and Celsius pairs beside each mark are rounded to the
        nearest 25&nbsp;&deg;F and 10&nbsp;&deg;C, so the columns below do not convert back into each
        other exactly. Treat the table as what a dial says, and use the formula when a recipe gives an
        exact figure.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[720px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
