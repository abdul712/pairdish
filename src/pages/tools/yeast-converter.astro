---
/**
 * Yeast Conversion Calculator Tool Page
 *
 * Convert between different types of yeast for baking.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import YeastConverter from '../../components/tools/YeastConverter';
---

<BaseLayout
  title="Yeast Conversion Calculator"
  description="Convert between active dry yeast, instant yeast, fresh yeast, and sourdough starter. Accurate ratios and helpful tips for perfect bread every time."
  keywords={['yeast conversion', 'yeast substitute', 'active dry to instant yeast', 'fresh yeast conversion', 'baking yeast calculator']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Yeast Conversion Calculator', url: '/tools/yeast-converter' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Yeast Converter</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Yeast <span class="text-accent text-[var(--color-wine)]">Conversion Calculator</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Recipe calls for one yeast type but you have another? Convert between active dry,
          instant, fresh yeast, and sourdough starter with accurate ratios.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <YeastConverter client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Yeast Types
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Active Dry vs Instant
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Active dry yeast needs proofing in warm water before use. Instant yeast has
              smaller granules and can be mixed directly with flour. Instant rises faster
              but both produce similar results.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Fresh Yeast Benefits
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Fresh yeast (also called cake yeast) is perishable but offers slightly
              better flavor and faster activation. Many professional bakers prefer it
              for artisan breads.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Quick Conversion Chart
        </h3>

        <div class="grid grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block text-2xl mb-1">🟡</span>
            <span class="block font-bold text-amber-700">1 tsp</span>
            <span class="block text-xs text-amber-600">Active Dry</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block text-2xl mb-1">🟠</span>
            <span class="block font-bold text-orange-700">¾ tsp</span>
            <span class="block text-xs text-orange-600">Instant</span>
          </div>
          <div class="text-center p-4 bg-yellow-50 rounded-lg">
            <span class="block text-2xl mb-1">🧈</span>
            <span class="block font-bold text-yellow-700">14g</span>
            <span class="block text-xs text-yellow-600">Fresh</span>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Published conversion multipliers + packet-based substitutions -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        Converting Between Fresh, Active Dry and Instant Yeast
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Fresh yeast, active dry yeast and instant yeast are the same organism packaged at three
        different moisture levels, so the conversion is a matter of weight rather than of strength.
        King Arthur Baking&rsquo;s professional reference publishes the two multipliers that cover
        most substitutions, both written from fresh yeast as the starting point because that is
        where the water is.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[720px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Published conversion rules (King Arthur Baking professional reference).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Converting</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Multiply the fresh weight by</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Handling note</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fresh yeast to active dry yeast</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">0.4</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Active dry must be hydrated in warm water before it goes into the
                dough.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fresh yeast to instant yeast</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">0.33</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Instant can be added straight to the flour; make up the weight difference
                with extra water so the dough yield stays the same.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Going the other way means dividing by the same multiplier, which is how a recipe written
        around a packet of dry yeast gets translated to the block of fresh yeast at the back of the
        shop. The two multipliers also imply a cross-rate between the dry yeasts: instant yeast is
        about 0.825 times the weight of active dry (0.33 divided by 0.4), so active dry is about
        1.21 times instant. Keep that in mind as an estimate rather than a rule &mdash; the
        published guidance is to use the manufacturer&rsquo;s own ratio when it is printed on the
        package.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[720px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Worked conversions. Arithmetic from the rules above: fresh &times; 0.4 for
            active dry, fresh &times; 0.33 for instant, and division to travel back to fresh.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">The recipe calls for</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Fresh</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Active dry</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Instant</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fresh yeast, 30 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">30 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">12 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">10 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fresh yeast, 10 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">10 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">4 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">3.3 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">One packet active dry, 7 g (1/4 oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 17.5 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">7 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 5.8 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">One packet instant, 7 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 21 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 8.5 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">7 g</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Reading the packet instead of the scale
      </h3>
      <ul class="list-disc pl-6 space-y-2 text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        <li>A 1/4 ounce (7 g) package of active dry yeast holds 2 1/2 teaspoons &mdash; Colorado
          State University Extension lists it as the equivalent of one compressed yeast cake.</li>
        <li>A tablespoon of active dry yeast is also listed as one cake of compressed yeast by New
          Mexico State University Extension, which is the handier measure when a recipe calls for
          an odd fraction of a packet.</li>
        <li>Only active dry needs the warm-water step. Instant yeast can be mixed straight into the
          flour, and fresh yeast is crumbled into the dough.</li>
        <li>Weigh rather than scoop when precision matters: a tablespoon of active dry is a volume
          measure, and the two dry yeasts differ in granule size.</li>
      </ul>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        What a conversion does not fix
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Changing the yeast form does not change how fast the dough rises. Dough temperature, the
        amount of sugar and salt in the formula, and the temperature of the room do that, which is
        why the same recipe can double in ninety minutes in summer and in four hours in a cold
        kitchen. Judge the rise by the dough rather than the clock: the
        <a href="/tools/bread-proofing" class="text-[var(--color-wine)] underline">bread proofing guide</a> covers the visual cues and
        the time-and-temperature reference table, the
        <a href="/tools/sourdough-calculator" class="text-[var(--color-wine)] underline">sourdough calculator</a> covers the wild-yeast
        case, and the <a href="/tools/flour-substitution" class="text-[var(--color-wine)] underline">flour substitution tool</a>
        covers the other half of a formula swap when the flour changes at the same time. If you
        are scaling the whole recipe rather than one ingredient, run it through the
        <a href="/tools/recipe-scaler" class="text-[var(--color-wine)] underline">recipe scaler</a> afterwards.
      </p>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: <a href="https://www.kingarthurbaking.com/pro/reference/yeast" rel="noopener" class="text-[var(--color-wine)] underline">King Arthur Baking, professional reference: &ldquo;Yeast&rdquo;</a>;
        <a href="https://extension.colostate.edu/resource/ingredient-substitutions/" rel="noopener" class="text-[var(--color-wine)] underline">Colorado State University Extension, &ldquo;Ingredient Substitutions&rdquo;</a>;
        <a href="https://pubs.nmsu.edu/_e/E131/index.html" rel="noopener" class="text-[var(--color-wine)] underline">New Mexico State University Extension, &ldquo;In a Pinch: Ingredient Substitution&rdquo;</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Baking Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/pan-size-converter" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center text-orange-700">
            🍰
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Pan Size Converter</h4>
            <p class="text-sm text-[var(--text-muted)]">Convert between pan sizes</p>
          </div>
        </a>

        <a href="/tools/unit-converter" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            ⚖️
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Unit Converter</h4>
            <p class="text-sm text-[var(--text-muted)]">Cups, grams, ounces</p>
          </div>
        </a>

        <a href="/tools/oven-temperature" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-red-100 flex items-center justify-center text-red-700">
            🌡️
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Oven Temperature</h4>
            <p class="text-sm text-[var(--text-muted)]">F/C/Gas Mark converter</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Yeast Conversion Calculator",
  "description": "Convert between active dry yeast, instant yeast, fresh yeast, and sourdough starter. Accurate ratios and helpful tips for perfect bread every time.",
  "url": "https://pairdish.com/tools/yeast-converter",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
