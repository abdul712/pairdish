---
/**
 * What Should I Cook? Generator Page
 *
 * Get personalized dinner inspiration based on mood and preferences.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import RecipeGenerator from '../../components/tools/RecipeGenerator';
---

<BaseLayout
  title="What Should I Cook Tonight? | Recipe Generator"
  description="Not sure what to make for dinner? Our recipe generator suggests perfect meals based on your mood, time, cuisine preferences, and dietary needs."
  keywords={['what should I cook', 'recipe generator', 'dinner ideas', 'meal inspiration', 'recipe finder', 'dinner tonight']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Recipe Generator', url: '/tools/recipe-generator' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">What Should I Cook?</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          What Should I <span class="text-accent text-[var(--color-wine)]">Cook Tonight?</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Stuck in a dinner rut? Answer a few quick questions about your mood, time, and preferences,
          and we'll suggest the perfect meal for tonight.
        </p>
      </div>
    </div>
  </section>

  <!-- Generator Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <RecipeGenerator client:load />
    </div>
  </section>

  <!-- Tips Section -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Recipe Selection Tips
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          <div class="p-5 bg-[var(--color-cream)] rounded-xl">
            <h3 class="font-display text-lg font-semibold text-[var(--text-primary)] mb-2">
              Match Your Energy
            </h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Tired after a long day? Choose "Low-Effort" recipes. Feeling inspired on a weekend?
              Go adventurous! Your energy level matters more than you think.
            </p>
          </div>

          <div class="p-5 bg-[var(--color-cream)] rounded-xl">
            <h3 class="font-display text-lg font-semibold text-[var(--text-primary)] mb-2">
              Time Is Everything
            </h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Be realistic about your cooking time. A recipe that says 30 minutes might take 45
              for a new cook. Build in extra time for prep and cleanup.
            </p>
          </div>

          <div class="p-5 bg-[var(--color-cream)] rounded-xl">
            <h3 class="font-display text-lg font-semibold text-[var(--text-primary)] mb-2">
              Use What You Have
            </h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Before shopping, check your fridge and pantry. Many recipes are flexible -
              you can often substitute vegetables or proteins with what you already own.
            </p>
          </div>

          <div class="p-5 bg-[var(--color-cream)] rounded-xl">
            <h3 class="font-display text-lg font-semibold text-[var(--text-primary)] mb-2">
              Plan for Leftovers
            </h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Cook once, eat twice! Many recipes taste even better the next day.
              Stews, curries, and pasta dishes make excellent lunches.
            </p>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        More Meal Planning Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/leftover-matcher" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-2xl">
            🥫
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Leftover Matcher</h4>
            <p class="text-sm text-[var(--text-muted)]">Recipes from what you have</p>
          </div>
        </a>

        <a href="/tools/cooking-style-quiz" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center text-2xl">
            🎯
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Cooking Style Quiz</h4>
            <p class="text-sm text-[var(--text-muted)]">Discover your cooking type</p>
          </div>
        </a>

        <a href="/tools/meal-prep" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-2xl">
            📅
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Meal Prep Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Plan your week ahead</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "What Should I Cook Tonight? | Recipe Generator",
  "description": "Not sure what to make for dinner? Our recipe generator suggests perfect meals based on your mood, time, cuisine preferences, and dietary needs.",
  "url": "https://pairdish.com/tools/recipe-generator",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
