---
/**
 * Flour Substitution Calculator Tool Page
 *
 * Convert between different flour types with proper ratios.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import FlourSubstitution from '../../components/tools/FlourSubstitution';
---

<BaseLayout
  title="Flour Substitution Calculator"
  description="Convert between all-purpose, bread, cake, pastry, whole wheat, and specialty flours. Get exact ratios and additional ingredients needed for perfect results."
  keywords={['flour substitution', 'flour conversion', 'cake flour substitute', 'bread flour substitute', 'flour types', 'baking flour calculator']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Flour Substitution Calculator', url: '/tools/flour-substitution' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Flour Substitution</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Flour <span class="text-accent text-[var(--color-wine)]">Substitution Calculator</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Recipe calls for cake flour but you only have all-purpose? Get the exact
          ratios and additions needed to substitute between flour types.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <FlourSubstitution client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Flour Types
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              It's All About Protein
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              The main difference between flour types is protein content. Higher protein
              means more gluten when mixed with water. Bread flour (12-14%) makes chewy
              bread; cake flour (7-9%) makes tender cake.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Why Substitution Works
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              By adjusting ratios and adding starches (which reduce gluten development),
              you can approximate one flour with another. Results may differ slightly,
              but substitutions work for most home baking.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Common Substitutions
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-pink-50 rounded-lg">
            <span class="block font-bold text-pink-700 text-sm">Cake Flour</span>
            <span class="block text-xs text-pink-600 mt-1">⅞ cup AP + 2 tbsp cornstarch</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block font-bold text-orange-700 text-sm">Bread Flour</span>
            <span class="block text-xs text-orange-600 mt-1">AP + vital wheat gluten</span>
          </div>
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <span class="block font-bold text-blue-700 text-sm">Self-Rising</span>
            <span class="block text-xs text-blue-600 mt-1">AP + baking powder + salt</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Baking Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/yeast-converter" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🟡
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Yeast Converter</h4>
            <p class="text-sm text-[var(--text-muted)]">Convert between yeast types</p>
          </div>
        </a>

        <a href="/tools/sourdough-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🫙
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Sourdough Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Calculate dough hydration</p>
          </div>
        </a>

        <a href="/tools/unit-converter" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            ⚖️
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Unit Converter</h4>
            <p class="text-sm text-[var(--text-muted)]">Cups, grams, ounces</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
