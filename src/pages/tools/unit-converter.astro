---
/**
 * Cooking Unit Converter Tool Page
 *
 * Interactive tool for converting between cooking measurements.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import UnitConverter from '../../components/tools/UnitConverter';
---

<BaseLayout
  title="Cooking Unit Converter"
  description="Convert between cups, tablespoons, grams, ounces, and more. Includes ingredient-specific volume-to-weight conversions for accurate baking."
  keywords={['cooking converter', 'cups to grams', 'tablespoon to ml', 'kitchen converter', 'baking measurements', 'cooking unit calculator']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Cooking Unit Converter', url: '/tools/unit-converter' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Unit Converter</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Cooking <span class="text-accent text-[var(--color-wine)]">Unit Converter</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Convert between US and metric measurements instantly. Our converter includes
          ingredient-specific densities for accurate volume-to-weight conversions.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <UnitConverter client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Cooking Measurements
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Volume vs. Weight
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Professional bakers prefer weight measurements because they're more accurate.
              1 cup of flour can vary from 120g to 150g depending on how it's scooped.
              Weighing ingredients eliminates this inconsistency.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              US vs. Metric
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Most of the world uses metric (grams, milliliters) while the US uses
              cups and ounces. Our converter bridges both systems, making international
              recipes accessible to everyone.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Quick Reference
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          <div class="text-center p-4 bg-[var(--color-cream)] rounded-lg">
            <span class="block text-2xl mb-2">1 cup</span>
            <span class="text-sm text-[var(--text-muted)]">= 16 tablespoons</span>
          </div>
          <div class="text-center p-4 bg-[var(--color-wine-glow)] rounded-lg">
            <span class="block text-2xl mb-2">1 tbsp</span>
            <span class="text-sm text-[var(--text-muted)]">= 3 teaspoons</span>
          </div>
          <div class="text-center p-4 bg-[var(--color-cream)] rounded-lg">
            <span class="block text-2xl mb-2">1 oz</span>
            <span class="text-sm text-[var(--text-muted)]">= 28.35 grams</span>
          </div>
          <div class="text-center p-4 bg-[var(--color-cream)] rounded-lg">
            <span class="block text-2xl mb-2">1 cup</span>
            <span class="text-sm text-[var(--text-muted)]">= 237 ml</span>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Legal U.S. cooking measures + one-cup weights -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        How a Cup Is Actually Defined
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        There is no single international cup. A U.S. recipe cup, a metric cup and a British cup are
        three different volumes, which is why a converter is worth more than a conversion chart.
        For food sold in the United States there is one authoritative set of definitions: the
        nutrition-labelling rule spells out the household measures in metric terms, and those
        rounded numbers are what appears on every U.S. nutrition label and in every recipe that has
        been checked against them.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[560px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Household measures as defined for U.S. nutrition labelling, 21 CFR 101.9(b)(5)(viii).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Measure</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Label definition</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Equals</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Teaspoon</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">5 mL</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">The base unit for small measures; three make a tablespoon.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tablespoon</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">15 mL</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Three teaspoons.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cup</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">240 mL</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sixteen tablespoons, or eight labelled fluid ounces.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fluid ounce</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">30 mL</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Two tablespoons.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Ounce in weight</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">28 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">The weight ounce, not the fluid ounce &mdash; the two are not interchangeable.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Those labelling values are deliberately rounded, and it is worth knowing by how much. Eight
        fluid ounces of the customary U.S. fluid ounce (29.5735 mL) come to 236.6 mL, so the
        labelled 240 mL cup is about 1.4 per cent larger than the cup you would pour from a
        graduated jug. That gap never matters for a single cake and it does matter when a
        commercial recipe is scaled by a hundred. Where the number has to be exact, weigh the
        ingredient instead &mdash; a cup is a volume, and the same volume of two powders weighs two
        different amounts.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        What one cup actually weighs
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        This is the table the flour-conversion questions all come down to. Fill a cup by scooping
        straight from the bag and you compact the flour and add on the order of ten to twenty per
        cent more of it; spoon it in and level it and you get the published figure. Both methods
        are called "one cup", and the recipes that work in grams are the ones that avoid the
        argument.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Published one-cup weights (King Arthur Baking ingredient weight chart; figures listed
            by the chart in cups, half cups or quarter cups are stated per cup here).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Ingredient</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">1 cup weighs</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Per tablespoon</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">All-purpose flour</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">120 g (4&#188; oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 7.5 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Bread flour</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">120 g (4&#188; oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 7.5 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cake flour, unbleached</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">120 g (4&#188; oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 7.5 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Whole wheat flour</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">113 g (4 oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 7 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Self-rising flour</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">113 g (4 oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 7 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cornstarch</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">112 g (4 oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 7 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sugar (granulated white)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">198 g (7 oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 12 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Brown sugar, packed</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">213 g (7&#189; oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 13 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Confectioners' sugar, unsifted</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">113 g (4 oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 7 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cocoa, unsweetened</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">84 g (listed at 42 g per &#189; cup)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 5 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Butter</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">227 g (8 oz; listed at 113 g per &#189; cup)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 14 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Water or milk</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">227 g (8 oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 14 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Honey</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">336 g (listed at 21 g per tablespoon)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">21 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Table salt</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">288 g (listed at 18 g per tablespoon)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">18 g</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Rolled oats</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">89 g (3&#8539; oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 5.5 g</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cornmeal, whole</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">138 g (4&#8541; oz)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">About 8.6 g</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Read the table as a set of density conversions rather than a fixed law. A cup of flour
        holds 240 mL of volume whichever way you fill it; what changes is how much flour occupies
        that volume. Once you have the gram weight, the
        <a href="/tools/flour-substitution" class="text-[var(--color-wine)] underline">flour
        substitution calculator</a> turns it into a swap between flour types, and the
        <a href="/tools/recipe-scaler" class="text-[var(--color-wine)] underline">recipe scaler</a>
        applies it to a whole recipe instead of a single line.
      </p>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: <a href="https://www.ecfr.gov/current/title-21/chapter-I/subchapter-B/part-101/subpart-A/section-101.9" rel="noopener" class="text-[var(--color-wine)] underline">21 CFR 101.9(b)(5)(viii), nutrition labelling of food, on eCFR</a>;
        <a href="https://www.kingarthurbaking.com/learn/ingredient-weight-chart" rel="noopener" class="text-[var(--color-wine)] underline">King Arthur Baking, ingredient weight chart</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/recipe-scaler" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            📏
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Recipe Scaler</h4>
            <p class="text-sm text-[var(--text-muted)]">Scale recipes up or down</p>
          </div>
        </a>

        <a href="/tools/oven-temperature" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center text-orange-700">
            🌡️
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Oven Temperature</h4>
            <p class="text-sm text-[var(--text-muted)]">F, C, and Gas Mark</p>
          </div>
        </a>

        <a href="/tools/substitution-finder" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            🔄
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Substitution Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Ingredient swaps</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cooking Unit Converter",
  "description": "Convert between cups, tablespoons, grams, ounces, and more. Includes ingredient-specific volume-to-weight conversions for accurate baking.",
  "url": "https://pairdish.com/tools/unit-converter",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
