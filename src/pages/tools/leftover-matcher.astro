---
/**
 * Leftover Ingredient Recipe Matcher Tool Page
 *
 * Interactive tool to find recipes based on ingredients you have.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import LeftoverMatcher from '../../components/tools/LeftoverMatcher';
---

<BaseLayout
  title="Leftover Ingredient Recipe Matcher"
  description="Turn your leftovers into delicious meals! Enter ingredients you have and get recipe suggestions instantly. Never waste food again with our ingredient-to-recipe finder."
  keywords={['leftover recipes', 'what to cook with', 'ingredient recipe finder', 'use up ingredients', 'fridge cleanout recipes']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Leftover Ingredient Recipe Matcher', url: '/tools/leftover-matcher' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Leftover Matcher</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Leftover <span class="text-accent text-[var(--color-wine)]">Recipe Matcher</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Got random ingredients in your fridge? Select what you have and we'll suggest
          delicious recipes you can make right now—no grocery run required.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <LeftoverMatcher client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Reducing Food Waste Through Creative Cooking
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              The Food Waste Problem
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              The average American household throws away $1,500 worth of food each year.
              By learning to cook with what you have, you can save money and reduce waste.
              Most "leftover" ingredients can become the star of a delicious meal.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Flexible Cooking
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Most recipes are more flexible than they seem. Missing an ingredient?
              There's usually a substitute. Have extra vegetables? Add them to the mix.
              The best home cooks know how to improvise with what's on hand.
            </p>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/flavor-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-[var(--color-wine-glow)] flex items-center justify-center text-[var(--color-wine)]">
            ✨
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Flavor Pairing Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Discover flavor combinations</p>
          </div>
        </a>

        <a href="/tools/substitution-finder" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            🔄
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Substitution Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Find ingredient swaps</p>
          </div>
        </a>

        <a href="/tools/recipe-scaler" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            📐
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Recipe Scaler</h4>
            <p class="text-sm text-[var(--text-muted)]">Adjust recipe quantities</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Leftover Ingredient Recipe Matcher",
  "description": "Turn your leftovers into delicious meals! Enter ingredients you have and get recipe suggestions instantly. Never waste food again with our ingredient-to-recipe finder.",
  "url": "https://pairdish.com/tools/leftover-matcher",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
