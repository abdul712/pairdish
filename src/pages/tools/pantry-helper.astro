---
/**
 * Pantry Pairing Helper Tool Page
 *
 * Build meals from pantry staples with smart pairing suggestions.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import PantryHelper from '../../components/tools/PantryHelper';
---

<BaseLayout
  title="Pantry Pairing Helper"
  description="Build delicious meals from your pantry staples. Select ingredients you have on hand and discover meal ideas with smart pairing suggestions."
  keywords={['pantry meals', 'pantry staples', 'pantry cooking', 'what to cook', 'ingredient pairing', 'meal ideas']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Pantry Pairing Helper', url: '/tools/pantry-helper' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Pantry Helper</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Pantry <span class="text-accent text-[var(--color-wine)]">Pairing Helper</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Select the pantry staples you have on hand and discover meal ideas that make
          the most of what's already in your kitchen.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <PantryHelper client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Building Meals from Pantry Staples
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              The Well-Stocked Pantry
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              A thoughtfully stocked pantry is the foundation of effortless cooking.
              With the right combination of grains, proteins, and seasonings, you can
              create countless meals with minimal fresh ingredients.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Pantry-First Cooking
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Instead of searching for recipes and buying ingredients, pantry-first cooking
              starts with what you have. It reduces food waste, saves money, and often
              leads to creative, satisfying meals.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Essential Pantry Categories
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block text-2xl mb-1">🌾</span>
            <span class="block font-bold text-amber-700">Grains</span>
            <span class="block text-xs text-amber-600">Rice, pasta, quinoa</span>
          </div>
          <div class="text-center p-4 bg-red-50 rounded-lg">
            <span class="block text-2xl mb-1">🥫</span>
            <span class="block font-bold text-red-700">Canned</span>
            <span class="block text-xs text-red-600">Beans, tomatoes, fish</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block text-2xl mb-1">🧂</span>
            <span class="block font-bold text-orange-700">Spices</span>
            <span class="block text-xs text-orange-600">Salt, pepper, herbs</span>
          </div>
          <div class="text-center p-4 bg-yellow-50 rounded-lg">
            <span class="block text-2xl mb-1">🫒</span>
            <span class="block font-bold text-yellow-700">Oils</span>
            <span class="block text-xs text-yellow-600">Olive, sesame, coconut</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/leftover-matcher" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center text-teal-700">
            🥗
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Leftover Recipe Matcher</h4>
            <p class="text-sm text-[var(--text-muted)]">Find recipes for your ingredients</p>
          </div>
        </a>

        <a href="/tools/substitution-finder" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            🔄
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Substitution Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Find ingredient substitutes</p>
          </div>
        </a>

        <a href="/tools/meal-prep" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center text-teal-700">
            📅
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Meal Prep Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Plan your weekly meals</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Guides
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <a href="/articles/pantry-meal-planning" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center text-orange-700">
            🥫
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Pantry Meal Planning</h4>
            <p class="text-sm text-[var(--text-muted)]">Turn shelf staples into real dinners.</p>
          </div>
        </a>

        <a href="/articles/grocery-budget-meal-planning" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-rose-100 flex items-center justify-center text-rose-700">
            🛒
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Grocery Budget Meal Planning</h4>
            <p class="text-sm text-[var(--text-muted)]">Build a week around your real number.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
