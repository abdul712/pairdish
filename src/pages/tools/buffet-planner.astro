---
/**
 * Buffet Menu Planner Tool Page
 *
 * Interactive tool for planning buffet quantities and menu balance.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import BuffetPlanner from '../../components/tools/BuffetPlanner';
---

<BaseLayout
  title="Buffet Menu Planner"
  description="Plan a buffet with quantities per guest: dish recommendations, category balance for fish, meat, vegetable and salad, and serving amounts by meal."
  keywords={['buffet planner', 'buffet quantities per person', 'how much food for buffet', 'buffet menu planning', 'catering calculator']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Buffet Menu Planner', url: '/tools/buffet-planner' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Buffet Planner</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Buffet <span class="text-accent text-[var(--color-wine)]">Menu Planner</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Calculate exact quantities for your buffet spread. Build a balanced menu with
          the right mix of mains, sides, and accompaniments for any occasion.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <BuffetPlanner client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Buffet Planning Essentials
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              The Golden Rule of Quantities
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Plan for 1 to 1.5 pounds of food per person total. This breaks down to roughly
              6 oz of protein, 4-5 oz of starches, 4 oz of vegetables/salads, and 2-3 oz of bread.
              Always add 10-15% buffer for hungry guests.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Menu Balance
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              A well-balanced buffet includes 2-3 proteins, 2-3 starches, 2-3 vegetables or salads,
              bread, and dessert. Mix hot and cold items, and always include at least one
              vegetarian main option.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Food Quantities Per Person by Category
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
          <div class="text-center p-4 bg-red-50 rounded-lg">
            <span class="block text-2xl font-bold text-red-700">6 oz</span>
            <span class="block text-sm text-red-600">Protein/Main</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block text-2xl font-bold text-amber-700">4-5 oz</span>
            <span class="block text-sm text-amber-600">Starches</span>
          </div>
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block text-2xl font-bold text-green-700">4 oz</span>
            <span class="block text-sm text-green-600">Vegetables</span>
          </div>
          <div class="text-center p-4 bg-yellow-50 rounded-lg">
            <span class="block text-2xl font-bold text-yellow-700">2-3 oz</span>
            <span class="block text-sm text-yellow-600">Bread</span>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Buffet Menu Planning -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        Buffet Menu Planning That Holds Up on the Line
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Quantities are only half of a buffet. The other half is menu shape: how many options sit in
        each category, and whether the food can stay safe while guests work their way down the
        table. Extension guidance for group meals is explicit that a buffet needs planning for
        contrast in colour, texture, shape, temperature and flavour &mdash; and that self-service
        means portion control is lost, so each dish needs a little more headroom than a plated meal
        would.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[680px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pt-3 text-left text-sm font-medium text-[var(--text-muted)]">
            How many choices to put in each category, and what each one does for the table.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)]">Category</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)]">How many options</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)]">Why it earns its place</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Protein / main</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">2&ndash;3</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Guests choose by sight, and one option is always the one that empties
              first. Two structurally different mains (one roasted or braised, one lighter) cover
              most dietary drop-outs without a separate menu.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Starch</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">2&ndash;3</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">The volume filler that keeps a crowd fed when the mains run short. Vary the
              shape &mdash; a grain, a potato or bread-style item, and a pasta or rice.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Vegetable or salad</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">2&ndash;3</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">One cold or raw option and one cooked option give the temperature and
              texture contrast group meals are planned around.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Bread</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1&ndash;2</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cheap insurance at the end of the line, and the carrier for whatever sauce
              or spread you are serving.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sauce / condiment</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">2</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">One sharp or acidic, one rich. They let guests re-season a plate instead of
              leaving food behind.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Dessert</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1&ndash;2</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">One dependable option beats three half-eaten ones; if the event runs long,
              a dessert that holds at room temperature is the safer pick.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Keep it out of the danger zone
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        A buffet line is the highest-risk way to serve food, because everything sits out while people
        eat. The U.S. Department of Agriculture's Food Safety and Inspection Service publishes the
        limits &mdash; bacteria grow most rapidly between 40&nbsp;&#176;F and 140&nbsp;&#176;F,
        doubling in number in as little as 20 minutes, which is why the holding rules are strict.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[620px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pt-3 text-left text-sm font-medium text-[var(--text-muted)]">
            USDA FSIS holding rules for a self-service buffet.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)]">Situation</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)]">The rule</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Bacterial growth zone</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">40&nbsp;&#176;F to 140&nbsp;&#176;F &mdash; numbers can double in as
              little as 20 minutes.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Hot dishes on the line</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Hold at or above 140&nbsp;&#176;F using chafing dishes, preheated steam
              tables, warming trays or slow cookers. Warm is not the same as hot.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cold dishes on the line</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Hold at or below 40&nbsp;&#176;F, with containers nested in ice where
              possible.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Total time out of refrigeration</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Two hours maximum. Above 90&nbsp;&#176;F &mdash; a summer cookout &mdash;
              cut that to one hour.</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Packing away the leftovers</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Shallow containers and into the refrigerator within two hours; improper
              cooling is one of the most common causes of foodborne illness.</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Reheating the next day</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">To an internal temperature of 165&nbsp;&#176;F, or until hot and steaming;
              cover and rotate in a microwave so it heats evenly.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-4">
        Two more habits that make a line run better. First, pre-portion anything risky &mdash; dips,
        dressings, sauces &mdash; into small serving dishes that can be swapped out when they hit
        the two-hour mark, instead of refilling one big bowl all afternoon. Second, keep the
        quantities honest: work out the head count in the
        <a href="/tools/party-calculator" class="text-[var(--color-wine)] underline">party food
        calculator</a>, add the drinks with the
        <a href="/tools/drink-calculator" class="text-[var(--color-wine)] underline">drink
        calculator</a>, and if the menu is mostly finger food, size it with the
        <a href="/tools/appetizer-planner" class="text-[var(--color-wine)] underline">appetizer
        planner</a> instead. The <a href="/articles/grocery-budget-meal-planning" class="text-[var(--color-wine)] underline">grocery
        budget guide</a> covers what those quantities cost at current U.S. prices.
      </p>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: USDA Food Safety and Inspection Service,
        <a href="https://www.fsis.usda.gov/food-safe-handling-and-preparation/food-safety-basics/danger-zone-40f-140f" rel="noopener" class="text-[var(--color-wine)] underline">"Danger
        Zone" (40&nbsp;&#176;F &ndash; 140&nbsp;&#176;F)</a>; University of Minnesota Extension,
        <a href="https://extension.umn.edu/food/preparing/cooking-at-home/cooking-safely-for-a-crowd/planning-the-quantity-food-occasion" rel="noopener" class="text-[var(--color-wine)] underline">Planning the
        quantity food occasion</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/party-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🎉
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Party Food Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Complete party food planning</p>
          </div>
        </a>

        <a href="/tools/appetizer-planner" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center text-purple-700">
            🍢
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Appetizer Planner</h4>
            <p class="text-sm text-[var(--text-muted)]">Calculate appetizer quantities</p>
          </div>
        </a>

        <a href="/tools/drink-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            🍹
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Drink Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Calculate beverages needed</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Guides
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <a href="/articles/what-to-serve-with-fried-fish" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-sky-100 flex items-center justify-center text-sky-700">
            🐟
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">What to Serve with Fried Fish</h4>
            <p class="text-sm text-[var(--text-muted)]">Classic sides and the science behind tartar sauce.</p>
          </div>
        </a>

        <a href="/articles/what-to-serve-with-roasted-potatoes" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🥔
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">What to Serve with Roasted Potatoes</h4>
            <p class="text-sm text-[var(--text-muted)]">12 mains and sauces, with per-person portion math.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Buffet Menu Planner",
  "description": "Plan a buffet with quantities per guest: dish recommendations, category balance for fish, meat, vegetable and salad, and serving amounts by meal.",
  "url": "https://pairdish.com/tools/buffet-planner",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
