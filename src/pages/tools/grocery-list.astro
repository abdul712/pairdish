---
/**
 * Grocery List Generator Tool Page
 *
 * Generate organized shopping lists from recipes.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import GroceryListGenerator from '../../components/tools/GroceryListGenerator';
---

<BaseLayout
  title="Grocery List Generator"
  description="Generate organized shopping lists from recipes. Items automatically sorted by store section for efficient grocery shopping."
  keywords={['grocery list generator', 'shopping list maker', 'recipe shopping list', 'meal planning', 'grocery organizer']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Grocery List Generator', url: '/tools/grocery-list' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Grocery List</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Grocery <span class="text-accent text-[var(--color-wine)]">List Generator</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Select recipes or add items manually. Your shopping list is automatically
          organized by store section for faster, more efficient trips.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <GroceryListGenerator client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Smart Grocery Shopping
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Shop by Section
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Organized shopping lists save time and reduce backtracking. When your list
              follows the store layout, you can breeze through aisles in order rather
              than criss-crossing the store.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Reduce Food Waste
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              A well-planned grocery list tied to your meal plan means you buy exactly
              what you need. No more forgotten ingredients or produce going bad because
              you bought too much.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Store Section Guide
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-10">
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block text-2xl mb-1">🥬</span>
            <span class="block font-bold text-green-700 text-sm">Produce</span>
          </div>
          <div class="text-center p-4 bg-red-50 rounded-lg">
            <span class="block text-2xl mb-1">🥩</span>
            <span class="block font-bold text-red-700 text-sm">Meat</span>
          </div>
          <div class="text-center p-4 bg-yellow-50 rounded-lg">
            <span class="block text-2xl mb-1">🧀</span>
            <span class="block font-bold text-yellow-700 text-sm">Dairy</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block text-2xl mb-1">🫙</span>
            <span class="block font-bold text-orange-700 text-sm">Pantry</span>
          </div>
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <span class="block text-2xl mb-1">❄️</span>
            <span class="block font-bold text-blue-700 text-sm">Frozen</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/meal-prep" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center text-teal-700">
            📅
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Meal Prep Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Plan your weekly meals</p>
          </div>
        </a>

        <a href="/tools/pantry-helper" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center text-teal-700">
            🫙
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Pantry Pairing Helper</h4>
            <p class="text-sm text-[var(--text-muted)]">Build meals from staples</p>
          </div>
        </a>

        <a href="/tools/leftover-matcher" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center text-teal-700">
            🥗
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Leftover Recipe Matcher</h4>
            <p class="text-sm text-[var(--text-muted)]">Find recipes for your ingredients</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Guides
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <a href="/articles/grocery-budget-meal-planning" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-rose-100 flex items-center justify-center text-rose-700">
            🛒
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Grocery Budget Meal Planning</h4>
            <p class="text-sm text-[var(--text-muted)]">Build a week around your real number.</p>
          </div>
        </a>

        <a href="/articles/pantry-meal-planning" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center text-orange-700">
            🥫
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Pantry Meal Planning</h4>
            <p class="text-sm text-[var(--text-muted)]">Turn shelf staples into real dinners.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Grocery List Generator",
  "description": "Generate organized shopping lists from recipes. Items automatically sorted by store section for efficient grocery shopping.",
  "url": "https://pairdish.com/tools/grocery-list",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
