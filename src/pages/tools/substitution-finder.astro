---
/**
 * Substitution Finder Tool Page
 *
 * Interactive tool for finding ingredient substitutes.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import SubstitutionFinder from '../../components/tools/SubstitutionFinder';
---

<BaseLayout
  title="Ingredient Substitution Finder"
  description="Find ingredient substitutes for allergies, dietary needs or an empty pantry — vegan, dairy-free, gluten-free and keto swaps with exact ratios."
  keywords={['ingredient substitution', 'baking substitutes', 'egg replacement', 'dairy-free alternatives', 'gluten-free flour', 'vegan baking', 'cooking substitutes']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Ingredient Substitution Finder', url: '/tools/substitution-finder' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Substitution Finder</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Ingredient <span class="text-accent text-[var(--color-wine)]">Substitution Finder</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Out of an ingredient? Have dietary restrictions? Find the perfect substitute
          with proper ratios and usage tips for baking and cooking.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <SubstitutionFinder client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Ingredient Substitutions
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Baking Substitutions
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Baking is chemistry, so substitutions require precision. Pay attention to
              ratios and understand that some substitutes affect texture, rise, and flavor.
              Start with tested substitutions and adjust based on results.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Cooking Substitutions
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Cooking is more forgiving than baking. You can often swap ingredients
              based on flavor profiles and textures. Taste as you go and adjust
              seasonings to account for any flavor differences.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Common Substitution Categories
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <span class="block text-2xl mb-2">🥛</span>
            <span class="block text-sm font-semibold text-blue-700">Dairy</span>
            <span class="block text-xs text-blue-600">Milk, butter, cream</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block text-2xl mb-2">🥚</span>
            <span class="block text-sm font-semibold text-amber-700">Eggs</span>
            <span class="block text-xs text-amber-600">Binders & leaveners</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block text-2xl mb-2">🌾</span>
            <span class="block text-sm font-semibold text-orange-700">Flour</span>
            <span class="block text-xs text-orange-600">GF & alternatives</span>
          </div>
          <div class="text-center p-4 bg-pink-50 rounded-lg">
            <span class="block text-2xl mb-2">🍬</span>
            <span class="block text-sm font-semibold text-pink-700">Sugar</span>
            <span class="block text-xs text-pink-600">Sweetener options</span>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Substituting by weight -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        Substituting Flour and Sugar by Weight, Not by Cup
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Most failed substitutions are volume problems, not ingredient problems. A cup measures
        the scoop as much as the flour: how deep you dug into the bag, and whether you sifted
        first, can move the same &ldquo;cup&rdquo; by 20 per cent or more. Weighing removes that
        variable, and it turns every swap into arithmetic. A cup of all-purpose flour weighs
        120 g, cake flour 120 g, pastry flour 106 g and whole-wheat pastry flour 96 g; packed
        brown sugar weighs 213 g a cup against 198 g for granulated.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        The gram weights to work from
      </h3>
      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            One cup, weighed &mdash; the numbers the substitutions below are built on.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Ingredient</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">1 cup</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Note</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">All-purpose flour</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">120 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">The reference flour for most substitution rules</td>
            </tr>
            <tr class="bg-[var(--color-cream)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Bread flour</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">120 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">More protein, so it takes up more water than all-purpose</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cake flour</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">120 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Lowest protein of the wheat flours; the lightest crumb</td>
            </tr>
            <tr class="bg-[var(--color-cream)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Pastry flour</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">106 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Between cake and all-purpose in protein and weight</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Whole-wheat pastry flour</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">96 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Lightest of the list; add liquid and expect a denser bake</td>
            </tr>
            <tr class="bg-[var(--color-cream)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cornstarch</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">112 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">A quarter cup weighs 28 g; used to dilute flour protein</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Granulated sugar</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">198 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1 lb is about 2&frac14; cups</td>
            </tr>
            <tr class="bg-[var(--color-cream)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Brown sugar, packed</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">213 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Denser because of the molasses and moisture it carries</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Confectioners&rsquo; sugar, unsifted</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">113 g</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Weigh it; a sifted cup is lighter still</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        The substitutions that come up most, worked out
      </h3>
      <ol class="list-decimal pl-6 space-y-3 text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        <li><strong>All-purpose to bread flour.</strong> Both weigh 120 g a cup, so 2&frac12;
          cups all-purpose (300 g) is 300 g of bread flour. The protein is higher, so bread
          flour drinks more water: add a spoonful or two of extra liquid and let the dough rest
          before deciding it is too stiff.</li>
        <li><strong>Cake flour, when you only have all-purpose.</strong> The extension rule is
          1 cup of sifted cake flour for 1 cup of sifted all-purpose flour minus 2 tablespoons
          (a scant &frac78; cup). By weight: 120 g all-purpose less 15 g leaves 105 g, and
          2 tablespoons of cornstarch adds about 14 g back, so 1 cup cake flour &asymp; 105 g
          all-purpose flour plus 14 g cornstarch. For a batch calling for 2&frac34; cups cake
          flour (330 g) that is about <strong>289 g all-purpose flour plus 39 g
          cornstarch</strong>. The swap works because cake flour is simply a lower-protein
          flour, and cornstarch dilutes the protein further.</li>
        <li><strong>A small cake-flour batch.</strong> 60 g of cake flour is half a cup, so it
          becomes about <strong>53 g all-purpose flour plus 7 g cornstarch</strong> &mdash; one
          level tablespoon.</li>
        <li><strong>All-purpose to pastry flour.</strong> Pastry flour weighs 106 g a cup
          against 120 g, so weigh 106 g of all-purpose for each cup the recipe asks for and you
          are within a gram of the same mass.</li>
        <li><strong>Granulated to brown sugar.</strong> Two cups of granulated sugar is 396 g.
          Packed brown sugar is denser at 213 g a cup, so 396 g of brown sugar is a little
          under 1&frac78; cups. Expect a softer, darker crumb, because brown sugar carries
          molasses and moisture. Going the other way, 1 cup of firmly packed brown sugar
          substitutes for 1 cup of granulated.</li>
        <li><strong>Cornstarch as a thickener.</strong> 1 tablespoon of cornstarch thickens
          like 2 tablespoons of all-purpose flour, but it must first be stirred into cold
          liquid &mdash; added dry to a hot pan it clumps.</li>
      </ol>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        What the tool does with your numbers
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The substitution finder above works from these same ratios. Enter amounts as weights
        where you can, and treat the answer as a starting point rather than a guarantee:
        protein content, moisture, and the leavening already in the recipe all shift a little
        when flours change. Re-check the dough or batter before it goes in the oven. For the
        rest of the arithmetic, the <a href="/tools/flour-substitution" class="text-[var(--color-wine)] underline">flour
        substitution table</a> covers the full weight list, the
        <a href="/tools/recipe-scaler" class="text-[var(--color-wine)] underline">recipe scaler</a> re-sizes the whole batch, and
        the <a href="/tools/unit-converter" class="text-[var(--color-wine)] underline">unit converter</a> moves between cups and
        grams for anything not in the table.
      </p>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: <a href="https://www.kingarthurbaking.com/learn/ingredient-weight-chart" rel="noopener" class="underline">King Arthur Baking &mdash; Ingredient Weight Chart</a>; <a href="https://randolph.ces.ncsu.edu/news/baking-substitutions-that-work/" rel="noopener" class="underline">N.C. Cooperative Extension, &ldquo;Baking Substitutions That Work&rdquo;</a>; <a href="https://extension.msstate.edu/publications/ingredient-substitutions-and-equivalents" rel="noopener" class="underline">Mississippi State University Extension, &ldquo;Ingredient Substitutions and Equivalents&rdquo;</a>; <a href="https://extension.usu.edu/archive/list-of-ingredient-substitutions-for-cooking-and-baking" rel="noopener" class="underline">Utah State University Extension, &ldquo;List of Ingredient Substitutions for Cooking and Baking&rdquo;</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/unit-converter" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            ⚖️
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Unit Converter</h4>
            <p class="text-sm text-[var(--text-muted)]">Convert measurements</p>
          </div>
        </a>

        <a href="/tools/recipe-scaler" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            📊
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Recipe Scaler</h4>
            <p class="text-sm text-[var(--text-muted)]">Scale recipes up or down</p>
          </div>
        </a>

        <a href="/tools/flavor-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center text-purple-700">
            ✨
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Flavor Pairing</h4>
            <p class="text-sm text-[var(--text-muted)]">Discover combinations</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Ingredient Substitution Finder",
  "description": "Find ingredient substitutes for allergies, dietary needs or an empty pantry — vegan, dairy-free, gluten-free and keto swaps with exact ratios.",
  "url": "https://pairdish.com/tools/substitution-finder",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
