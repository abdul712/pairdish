---
/**
 * Dietary Restriction Meal Finder Tool Page
 *
 * Find meals based on dietary restrictions and preferences.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import DietaryMealFinder from '../../components/tools/DietaryMealFinder';
---

<BaseLayout
  title="Dietary Restriction Meal Finder"
  description="Find delicious meals that match your dietary restrictions. Filter by vegetarian, vegan, gluten-free, keto, paleo, and more. Get recipes that fit your lifestyle."
  keywords={['dietary restriction recipes', 'vegan meals', 'gluten-free recipes', 'keto meal ideas', 'paleo recipes', 'allergy-friendly meals', 'diet meal finder']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Dietary Restriction Meal Finder', url: '/tools/dietary-finder' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Dietary Meal Finder</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Dietary Restriction <span class="text-accent text-[var(--color-wine)]">Meal Finder</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Select your dietary restrictions and discover delicious meals that fit your lifestyle.
          Filter by vegan, gluten-free, keto, paleo, and more.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <DietaryMealFinder client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Eating Well with Dietary Restrictions
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Multiple Restrictions
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Many diets overlap in their requirements. For example, a vegan meal is also
              vegetarian and dairy-free. Use our filters to find meals that meet ALL your needs.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Nutrient Balance
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              When following a restricted diet, ensure you're getting adequate protein, vitamins,
              and minerals. Variety is key—try different recipes to meet your nutritional needs.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Popular Dietary Approaches
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block font-bold text-green-700 text-sm">Vegetarian</span>
            <span class="block text-xs text-green-600 mt-1">No meat, may include dairy & eggs</span>
          </div>
          <div class="text-center p-4 bg-emerald-50 rounded-lg">
            <span class="block font-bold text-emerald-700 text-sm">Vegan</span>
            <span class="block text-xs text-emerald-600 mt-1">No animal products whatsoever</span>
          </div>
          <div class="text-center p-4 bg-lime-50 rounded-lg">
            <span class="block font-bold text-lime-700 text-sm">Keto</span>
            <span class="block text-xs text-lime-600 mt-1">Very low carb, high fat</span>
          </div>
          <div class="text-center p-4 bg-stone-100 rounded-lg">
            <span class="block font-bold text-stone-700 text-sm">Paleo</span>
            <span class="block text-xs text-stone-600 mt-1">Whole foods, no processed</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block font-bold text-amber-700 text-sm">Gluten-Free</span>
            <span class="block text-xs text-amber-600 mt-1">No wheat, barley, or rye</span>
          </div>
          <div class="text-center p-4 bg-purple-50 rounded-lg">
            <span class="block font-bold text-purple-700 text-sm">Whole30</span>
            <span class="block text-xs text-purple-600 mt-1">Reset diet for 30 days</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- What a restriction filter can and cannot decide -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        What a Restriction Filter Can and Cannot Decide
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The finder sorts meals against twelve restriction tags &mdash; vegetarian, vegan,
        gluten-free, dairy-free, nut-free, low-carb, keto, paleo, pescatarian, low-sodium,
        Whole30 and low-FODMAP. A filter answers one question: does this recipe contain an
        ingredient that breaks the tag? It cannot answer the harder question, which is whether
        a particular package on your shelf is safe. That decision happens at the label, and the
        label has its own rules.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        The nine allergens U.S. law requires the label to name
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Federal law names nine major food allergens. When a packaged food contains one of them,
        or an ingredient that contains one, the label has to say so in plain language. The list
        below is the FDA&rsquo;s own, with the places each allergen most often hides in a meal
        plan.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[680px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            The nine major food allergens named by U.S. law (FDA).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Allergen</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">What the label covers</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Where it hides in a pairing plan</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Milk</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Milk and ingredients derived from it</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Butter, ghee, cheese, cream, whey, casein, milk powder</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Eggs</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Egg white and yolk</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Mayonnaise, egg wash, some dried pasta, baked goods</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fish</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fish such as bass, flounder and cod</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fish sauce, anchovy in Worcestershire sauce, Caesar dressing</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Crustacean shellfish</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Crab, lobster and shrimp</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Shrimp paste, some stocks and bisques</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tree nuts</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Almonds, walnuts, pecans and other tree nuts</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Almond flour, cashew cream, nut butters, praline</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Peanuts</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Peanuts, listed separately from tree nuts</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Satay, some chilli sauces, peanut oil, baked goods</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Wheat</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Wheat and any ingredient that contains it</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Soy sauce, breadcrumbs, some stocks and spice blends</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Soybeans</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Soybeans and soy-derived ingredients</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tofu, tempeh, edamame, soy sauce, some marinades</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sesame</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sesame seed and sesame-derived ingredients</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tahini, hummus, sesame oil, some breads and crackers</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Sesame is the newest entry. The FASTER Act named it the ninth major allergen, and the
        labeling rules applied to sesame from 1 January 2023. The FDA also notes that products
        already on retail shelves before that date did not have to be relabelled, so older
        stock can still be missing the declaration. One practical consequence for this tool:
        peanuts are a legume and the FDA lists them separately from tree nuts, so a
        &ldquo;nut-free&rdquo; tag covers both classes here but the label is what settles it.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        &ldquo;Gluten-free&rdquo; is a defined claim, not a style of eating
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        For celiac disease the phrase on the box has a legal meaning. The FDA set the limit at
        less than 20 parts per million for the unavoidable presence of gluten, and a food may
        carry the claim only if it contains no wheat, rye, barley or crossbreed ingredient, no
        derivative of those grains that has not been processed to remove gluten, and no
        derivative that still leaves 20 ppm or more. Gluten itself is a mixture of proteins
        that occur naturally in wheat, rye and barley. That matters when you pick a side dish:
        a rice pilaf is not automatically gluten-free if the stock or the soy sauce in it brings
        wheat back in. Use the
        <a href="/tools/substitution-finder" class="text-[var(--color-wine)] underline">substitution
        finder</a> for the swap, then read the label on the replacement.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Where restricted eating patterns run short
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        A restriction removes foods, and removal is where nutrient gaps start. The amounts below
        are the published recommended daily intakes for adults from the NIH Office of Dietary
        Supplements, with the reason each one matters for a plant-based or allergen-avoiding
        pattern.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[680px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Recommended daily intakes for adults and why a restricted pattern changes them (NIH ODS).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Nutrient</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Published daily amount</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Who that number is for</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Why the pattern changes it</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Vitamin B12</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">2.4 mcg</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Adults</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Plant foods contain no B12 unless they are fortified</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Iron</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">8 mg for men 19&ndash;50; 18 mg for women 19&ndash;50</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Adults by sex</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Vegetarians need almost twice as much because nonheme iron is absorbed less well</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Calcium</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1,000 mg at 19&ndash;50; 1,200 mg for women 51&ndash;70 and everyone 71 and older</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Adults by age and sex</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">A dairy-free plate has to reach it through fortified drinks, tofu or greens such as kale and bok choi</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Zinc</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">11 mg for men; 8 mg for women</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Adults</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Beans, nuts and whole grains carry zinc, so legume and nut exclusions remove sources</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The finder is a starting point for the meal, not a nutrition audit. Once you have three
        meals that clear your tags, run the
        <a href="/tools/nutrition-calculator" class="text-[var(--color-wine)] underline">nutrition
        calculator</a> over the day to see whether the totals land near those figures, use the
        <a href="/tools/macro-calculator" class="text-[var(--color-wine)] underline">macro
        calculator</a> when protein and fat split matter, and keep the
        <a href="/tools/meal-prep" class="text-[var(--color-wine)] underline">meal prep
        planner</a> for the week so a restriction does not turn into a single repeated dish.
      </p>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources:
        <a href="https://www.fda.gov/food/nutrition-food-labeling-and-critical-foods/food-allergies" rel="noopener" class="text-[var(--color-wine)] underline">U.S. Food and Drug Administration, &ldquo;Food Allergies&rdquo;</a>;
        <a href="https://www.fda.gov/consumers/consumer-updates/gluten-free-means-what-it-says" rel="noopener" class="text-[var(--color-wine)] underline">FDA, &ldquo;&lsquo;Gluten-Free&rsquo; Means What It Says&rdquo;</a>;
        <a href="https://ods.od.nih.gov/factsheets/VitaminB12-Consumer/" rel="noopener" class="text-[var(--color-wine)] underline">NIH Office of Dietary Supplements, Vitamin B12</a>;
        <a href="https://ods.od.nih.gov/factsheets/Iron-Consumer/" rel="noopener" class="text-[var(--color-wine)] underline">Iron</a>;
        <a href="https://ods.od.nih.gov/factsheets/Calcium-Consumer/" rel="noopener" class="text-[var(--color-wine)] underline">Calcium</a>;
        <a href="https://ods.od.nih.gov/factsheets/Zinc-Consumer/" rel="noopener" class="text-[var(--color-wine)] underline">Zinc</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Health Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/nutrition-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.27 21.7s9.87-3.5 12.73-6.36a4.5 4.5 0 0 0-6.36-6.37C5.77 11.84 2.27 21.7 2.27 21.7zM8.64 14l-2.05-2.04M15.34 15l-2.46-2.46"/>
              <path d="M22 9s-1.33-2-3.5-2C16.86 7 15 9 15 9s1.33 2 3.5 2S22 9 22 9z"/>
              <path d="M15 2s-2 1.33-2 3.5S15 9 15 9s2-1.84 2-3.5C17 3.33 15 2 15 2z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Nutrition Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Full nutritional breakdown</p>
          </div>
        </a>

        <a href="/tools/substitution-finder" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 3h5v5"/>
              <path d="M8 3H3v5"/>
              <path d="M12 22v-8.3a4 4 0 0 0-1.172-2.872L3 3"/>
              <path d="m15 9 6-6"/>
            </svg>
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Substitution Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Find ingredient swaps</p>
          </div>
        </a>

        <a href="/tools/leftover-matcher" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/>
              <line x1="6" x2="18" y1="17" y2="17"/>
            </svg>
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Leftover Matcher</h4>
            <p class="text-sm text-[var(--text-muted)]">Recipes from ingredients</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Dietary Restriction Meal Finder",
  "description": "Find delicious meals that match your dietary restrictions. Filter by vegetarian, vegan, gluten-free, keto, paleo, and more. Get recipes that fit your lifestyle.",
  "url": "https://pairdish.com/tools/dietary-finder",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
