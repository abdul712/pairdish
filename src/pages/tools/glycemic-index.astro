---
/**
 * Glycemic Index Guide Tool Page
 *
 * Find low-GI food alternatives and pairings.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import GlycemicIndexGuide from '../../components/tools/GlycemicIndexGuide';
---

<BaseLayout
  title="Glycemic Index Guide"
  description="Find low-GI food alternatives to manage blood sugar. Browse 60+ foods with GI values, glycemic load, and smart swaps for healthier eating."
  keywords={['glycemic index', 'low GI foods', 'blood sugar', 'GI chart', 'glycemic load', 'diabetes diet', 'low glycemic recipes']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Glycemic Index Guide', url: '/tools/glycemic-index' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Glycemic Index Guide</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Glycemic Index <span class="text-accent text-[var(--color-wine)]">Guide</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Discover the glycemic index of common foods and find smart, lower-GI alternatives.
          Make informed choices for better blood sugar management.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <GlycemicIndexGuide client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Glycemic Index
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              GI vs. GL
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              <strong>Glycemic Index (GI)</strong> measures how quickly a food raises blood sugar on a
              scale of 0-100. <strong>Glycemic Load (GL)</strong> accounts for serving size, giving a
              more realistic picture of blood sugar impact.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Why It Matters
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Low-GI diets can help manage diabetes, reduce heart disease risk, maintain healthy weight,
              and provide sustained energy. High-GI foods cause rapid spikes and crashes.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          GI Categories
        </h3>

        <div class="grid grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block font-bold text-green-700 text-lg">Low</span>
            <span class="block text-sm text-green-600">0-55</span>
            <span class="block text-xs text-green-500 mt-1">Best choice</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block font-bold text-amber-700 text-lg">Medium</span>
            <span class="block text-sm text-amber-600">56-69</span>
            <span class="block text-xs text-amber-500 mt-1">Moderate</span>
          </div>
          <div class="text-center p-4 bg-red-50 rounded-lg">
            <span class="block font-bold text-red-700 text-lg">High</span>
            <span class="block text-sm text-red-600">70+</span>
            <span class="block text-xs text-red-500 mt-1">Limit intake</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- How GI bands and glycemic load are calculated -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        How the Glycemic Index Bands and the Glycemic Load Are Calculated
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        This tool lists 62 foods with three numbers each: the glycemic index, the glycemic load,
        and the carbohydrate and fibre the serving carries. Those three numbers are not
        independent. The load is derived from the index and the serving, which means a food can
        look alarming on one line and ordinary on the next. This section shows the arithmetic the
        calculator performs, and the published values it starts from.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        One measurement, two reference foods
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        A glycemic index value is relative: it describes a food&rsquo;s effect on blood glucose
        compared with a reference food given in the same amount of available carbohydrate. Two
        reference foods are in common use, glucose and white bread, and the international tables
        convert between them with a factor of 100/70 or 70/100. The table authors recommend
        reporting on the glucose scale, so every index on this page and in the calculator is a
        glucose-scale value. If you are reading a source that uses white bread as 100, multiply
        its number by 0.7 to compare it with ours.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Where the three bands sit
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The bands are conventions, not thresholds handed down by a regulator. The international
        tables describe low-glycemic foods as 55 or less on the glucose scale and high-glycemic
        foods as 70 or greater, which leaves 56 to 69 in the middle. The calculator applies the
        same cut-offs to the load, with 10 or less counted as low and 20 or more as high.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Band thresholds used by the calculator.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Band</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Glycemic index (glucose = 100)</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Glycemic load</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">What it describes</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Low</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">55 or less</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">10 or less</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Slow glucose release for the amount eaten</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Medium</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">56 to 69</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">11 to 19</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Between the two extremes</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">High</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">70 or greater</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">20 or more</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fast glucose release for the amount eaten</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Published index values for twenty common foods
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        These are averages drawn from multiple studies by different laboratories, published in the
