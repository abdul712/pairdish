---
/**
 * Appetizer Quantity Planner Tool Page
 *
 * Interactive tool for planning appetizer quantities for events.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import AppetizerPlanner from '../../components/tools/AppetizerPlanner';
---

<BaseLayout
  title="Appetizer Quantity Planner"
  description="Calculate how many appetizers to make for your party: per-person quantities, variety targets and prep timing for cocktail parties and receptions."
  keywords={['appetizer calculator', 'how many appetizers per person', 'party appetizer planner', 'hors doeuvres quantities', 'cocktail party planning']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Appetizer Quantity Planner', url: '/tools/appetizer-planner' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Appetizer Planner</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Appetizer <span class="text-accent text-[var(--color-wine)]">Quantity Planner</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Never run out of appetizers again. Calculate exactly how many pieces to make
          based on your guest count, event type, and serving style.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <AppetizerPlanner client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Appetizer Planning 101
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              How Many Per Person?
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              The golden rule: 8-12 pieces per person for a cocktail party where appetizers are the main food.
              For pre-dinner nibbles, 4-6 pieces is sufficient. Receptions fall in between at 6-10 pieces.
              Always round up for hungry guests.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Variety Matters
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Plan 3-5 varieties for small gatherings (under 20), and 6-8 for larger parties.
              Mix hot and cold items, include dips with crudités, and always have at least
              one vegetarian and one protein option.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Appetizers Per Person by Event Type
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-10">
          <div class="text-center p-4 bg-purple-50 rounded-lg">
            <span class="block text-2xl font-bold text-purple-700">8-12</span>
            <span class="block text-sm text-purple-600">Cocktail Party</span>
          </div>
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <span class="block text-2xl font-bold text-blue-700">4-6</span>
            <span class="block text-sm text-blue-600">Pre-Dinner</span>
          </div>
          <div class="text-center p-4 bg-pink-50 rounded-lg">
            <span class="block text-2xl font-bold text-pink-700">6-10</span>
            <span class="block text-sm text-pink-600">Reception</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block text-2xl font-bold text-amber-700">10-15</span>
            <span class="block text-sm text-amber-600">All-Evening</span>
          </div>
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block text-2xl font-bold text-green-700">5-8</span>
            <span class="block text-sm text-green-600">Casual</span>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Extension benchmarks for quantities + buffet holding limits -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        What the Extension Services Actually Recommend
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The per-event-type figures above are a starting point. Two university extension services
        publish the benchmarks behind them, and they agree on the shape of the answer: the count
        per person depends on when the party falls and whether a meal is coming afterwards. A
        reception that replaces dinner needs several times the food of a late-evening reception
        where guests have already eaten.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[720px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Per-person appetizer benchmarks published by extension services.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Occasion</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Appetizers per person</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Published by</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Reception with no meal</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">14 per hour</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Michigan State University Extension</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Over the lunch hour</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">10</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Michigan State University Extension</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Late afternoon or late evening reception</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">6 to 8</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Michigan State University Extension</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Four-hour party, first two hours</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 8</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">UAEX, University of Arkansas System Division of Agriculture</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Four-hour party, hours three and four</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">about 4</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">UAEX, University of Arkansas System Division of Agriculture</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The two sources describe different kinds of party, which is why the numbers look far apart.
        The Michigan State figures are a catering guide for receptions; the UAEX figures describe a
        four-hour party where the appetite falls off as the evening goes on. For a four-hour event,
        the UAEX rule is the more useful one to price, because it scales with the clock rather than
        assuming a single rate.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            The four-hour rule worked for three party sizes (UAEX: about 8 per person in the first
            two hours, about 4 per person after that).
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Guests</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">First two hours</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Last two hours</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Total pieces</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">20</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">160</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">80</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">240</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">50</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">400</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">200</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">600</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">100</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">800</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">400</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">1,200</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-10">
        That total is pieces, not varieties. Serving four kinds of appetizer to fifty guests means
        about 150 pieces of each rather than 600 of one, which is also the answer to the
        &ldquo;how much of each thing&rdquo; question the planner above cannot know on its own.
        Pair the quantities with the
        <a href="/tools/flavor-pairing" class="text-[var(--color-wine)] underline">flavour pairing tool</a> so the spread reads as a
        menu rather than a list.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
        Holding limits once the table is set
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Appetizer food sits out longer than any other course, which makes holding temperatures part
        of the planning rather than an afterthought. The limits below come from the same extension
        guidance as the quantities.
      </p>
      <div class="overflow-x-auto mb-8">
        <table class="w-full min-w-[640px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Holding and safety limits for a buffet or appetizer table.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Item</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Limit</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Published by</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Hot appetizers held for service</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">140 &deg;F or warmer</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">UAEX</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cold appetizers held for service</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">39 &deg;F or colder</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">UAEX</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Food left at room temperature</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">discard after 2 hours</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">UAEX; Michigan State University Extension</td>
            </tr>
            <tr class="bg-[var(--color-cream-soft)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Reheating a dish before it goes back out</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">165 &deg;F</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Michigan State University Extension</td>
            </tr>
          </tbody>
        </table>
      </div>
      <ul class="list-disc pl-6 space-y-2 text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        <li>Serve hot appetizers in stages rather than all at once, so a hot tray replaces an
          emptied one instead of sitting under a lamp.</li>
        <li>Nest cold dishes in bowls of ice, or use small trays and replace them often &mdash;
          dips, salads and cut fruit are the items that spend the longest on the table.</li>
        <li>Do not reheat food in a slow cooker. Heat it to 165 &deg;F in the oven or microwave
          first, then move it to the slow cooker to hold.</li>
        <li>Keep the count honest: the two-hour clock applies to the food that has been out, not to
          the party, so a late-arriving tray gets its own two hours.</li>
      </ul>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: <a href="https://www.uaex.uada.edu/counties/miller/news/fcs/holiday-foods/Appetizers-or-Hors-d-oeuvres-Options-are-Endless.aspx" rel="noopener" class="text-[var(--color-wine)] underline">UAEX (University of Arkansas System Division of Agriculture), &ldquo;Appetizers or hors d&rsquo;oeuvres Options are Endless&rdquo;</a>;
        <a href="https://www.canr.msu.edu/eventservices/uploads/files/Food%20&amp;%20Beverage%20Planning%20Tips.pdf" rel="noopener" class="text-[var(--color-wine)] underline">Michigan State University Extension, &ldquo;Food &amp; Beverage Planning Tips&rdquo; (PDF)</a>;
        <a href="https://www.canr.msu.edu/news/6_tips_for_food_safety_at_holidays_parties_and_dinners" rel="noopener" class="text-[var(--color-wine)] underline">Michigan State University Extension, &ldquo;6 tips for food safety at holidays parties and dinners&rdquo;</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/party-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🎉
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Party Food Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Complete party food planning</p>
          </div>
        </a>

        <a href="/tools/cheese-board-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-yellow-100 flex items-center justify-center text-yellow-700">
            🧀
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Cheese Board Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Plan your cheese board</p>
          </div>
        </a>

        <a href="/tools/drink-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700">
            🍹
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Drink Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Calculate beverages needed</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Appetizer Quantity Planner",
  "description": "Calculate how many appetizers to make for your party: per-person quantities, variety targets and prep timing for cocktail parties and receptions.",
  "url": "https://pairdish.com/tools/appetizer-planner",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
