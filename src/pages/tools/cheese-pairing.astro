---
/**
 * Cheese & Accompaniment Matcher Tool Page
 *
 * Find perfect pairings for any cheese type.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import CheesePairing from '../../components/tools/CheesePairing';
---

<BaseLayout
  title="Cheese & Accompaniment Matcher"
  description="Find perfect wine, fruit, nut, and charcuterie pairings for 16 popular cheeses. Build the ultimate cheese board with expert pairing recommendations."
  keywords={['cheese pairing', 'cheese board ideas', 'wine and cheese pairing', 'cheese accompaniments', 'cheese platter', 'brie pairing', 'cheddar pairing', 'blue cheese pairing']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Cheese & Accompaniment Matcher', url: '/tools/cheese-pairing' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Cheese Pairing</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Cheese & <span class="text-accent text-[var(--color-wine)]">Accompaniment Matcher</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Discover the perfect wines, fruits, nuts, and more to pair with your favorite cheeses.
          Build an unforgettable cheese board with our expert recommendations.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <CheesePairing client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          The Art of Cheese Pairing
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Match Intensity
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Pair mild cheeses with delicate accompaniments and bold cheeses with assertive partners.
              A subtle Brie pairs well with mild honey, while pungent Roquefort stands up to
              strong port wine.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Balance Sweet & Savory
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Sweet accompaniments like honey, jam, and dried fruits contrast beautifully with
              salty or pungent cheeses. This contrast creates complexity and keeps your
              palate interested.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Classic Cheese Categories
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block font-bold text-amber-700 text-sm">Soft</span>
            <span class="block text-xs text-amber-600 mt-1">Brie, Camembert, Burrata</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block font-bold text-orange-700 text-sm">Hard</span>
            <span class="block text-xs text-orange-600 mt-1">Cheddar, Parmesan, Pecorino</span>
          </div>
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <span class="block font-bold text-blue-700 text-sm">Blue</span>
            <span class="block text-xs text-blue-600 mt-1">Gorgonzola, Roquefort, Stilton</span>
          </div>
        </div>


      </article>
    </div>
  </section>


  <!-- Cheese pairing by family -->
  <section class="py-16 bg-[var(--color-cream)]">
    <div class="container max-w-4xl">
      <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-4">
        Cheese Pairing by Family, and What to Do With the Leftovers
      </h2>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        The matcher above works one cheese at a time. Families are faster: if you know which family
        the cheese belongs to, you already know roughly how assertive it is, and intensity matching
        does most of the work. Pair mild with delicate and bold with assertive, then let sweetness,
        salt and fat settle the details.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[680px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            The five families, common members, and the accompaniments that suit each one.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Family</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Common members</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Fruit, nuts and sweets that work</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Drink direction</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fresh (unripened)</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Mozzarella, ricotta, burrata, ch&egrave;vre</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tomatoes and olive oil, fresh herbs, citrus, light honey</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Crisp white, dry cider, sparkling water</td>
            </tr>
            <tr class="bg-[var(--color-cream)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Soft-ripened</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Brie, camembert, triple-cream</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Apple, grapes, figs, walnuts, honey</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sparkling wine, light red, cider</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Semi-hard</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Emmental, gouda, comt&eacute;, young cheddar</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Figs, pears, walnuts, honey, dried apricots</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fruity red, cider, amber beer</td>
            </tr>
            <tr class="bg-[var(--color-cream)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Hard</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Parmigiano-Reggiano, pecorino, aged cheddar</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Honey, balsamic, figs, marcona almonds</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Bold red, dry sherry</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Blue</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Roquefort, gorgonzola, stilton</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Pears, figs, honey, dates, walnuts</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Port, sweet wine, stout</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        Why cheese and wine work at all
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        It is not only tradition. An in-vitro tasting study (Rinaldi et al., <em>Current Research in
        Food Science</em> 2024) simulated cheese, wine and saliva together and measured what
        actually changes in the mouth. Two drivers kept coming up. First, the fat and protein in
        cheese bind the tannins in red wine, which softens the dry, puckering astringency. Second,
        the wine rinses the mouth of the fat the cheese leaves behind. Among the cheeses tested,
        a semi-hard cheese produced the best pairing with both red wines &mdash; exactly where
        emmental, comt&eacute; and gouda sit. That is the mechanical reason a semi-hard cheese with
        figs, walnuts and honey beside a fruity red is such a reliable combination. The same study
        notes that a roughly six-gram piece of cheese leaves a measurable film in the mouth:
        about 15% of it for high-fat cheeses against about 4% for low-fat ones, which is one more
        argument for a moderate-fat semi-hard over a triple-cream if you are serving several
        cheeses in a row.
      </p>

      <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-3">
        Which cheeses need the fridge
      </h3>
      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
        Fresh cheeses are the most perishable and the least forgiving. The Center for Dairy Research
        at the University of Wisconsin&ndash;Madison explains that two measurements &mdash; water
        activity and pH, alongside salt, acidity and an active starter culture &mdash; decide
        whether a cheese can safely be held out of temperature control at all. Firm, low-moisture,
        salty and acidic cheeses sit far from that line. High-moisture fresh cheeses sit close to
        it, so keep them cold until the moment they are served.
      </p>

      <div class="overflow-x-auto mb-10">
        <table class="w-full min-w-[680px] border-collapse text-left text-[var(--text-secondary)]">
          <caption class="px-4 pb-2 text-left text-sm font-medium text-[var(--text-muted)]">
            Storage at a glance. The two-hour rule applies to every row.
          </caption>
          <thead>
            <tr class="bg-[var(--color-cream-soft)]">
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Cheese</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Refrigerate?</th>
              <th class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Practical note</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Fresh &mdash; ricotta, mozzarella, burrata, ch&egrave;vre</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Yes, always</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Eat within a few days of opening; serve from the fridge onto the plate, not out on the table</td>
            </tr>
            <tr class="bg-[var(--color-cream)]">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Soft-ripened &mdash; brie, camembert</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Yes</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Bring to room temperature about 30 minutes before serving, then return the remainder to the fridge</td>
            </tr>
            <tr class="bg-white">
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Semi-hard, hard and blue</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Yes for storage</td>
              <td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tolerate a serving window better than fresh types, wrapped and away from strong odours</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-4">
        The serving clock is the one rule that applies to all of them: the USDA Food Safety and
        Inspection Service says never leave food out of refrigeration for more than two hours
        &mdash; one hour above 90 &deg;F &mdash; keeping cold food at or below 40 &deg;F and hot
        food at or above 140 &deg;F. For how much to buy, the
        <a href="/tools/cheese-board-calculator" class="text-[var(--color-wine)] underline">cheese board calculator</a> gives per-guest
        quantities by board style, and the
        <a href="/tools/cheese-board-builder" class="text-[var(--color-wine)] underline">cheese board builder</a> assembles the board
        itself. The <a href="/tools/flavor-pairing" class="text-[var(--color-wine)] underline">flavor pairing finder</a> covers the
        compound side of the same question.
      </p>

      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        Sources: <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC11245939/" rel="noopener" class="underline">Rinaldi et al., &ldquo;Exploring cheese and red wine pairing by an <em>in vitro</em> simulation of tasting&rdquo;, <em>Current Research in Food Science</em> 9:100792 (2024)</a>; <a href="https://cdr.wisc.edu/cheese-safety-storage" rel="noopener" class="underline">Center for Dairy Research, University of Wisconsin&ndash;Madison, &ldquo;Cheese Safety/Storage&rdquo;</a>; <a href="https://www.fsis.usda.gov/food-safety/safe-food-handling-and-preparation/food-safety-basics/danger-zone-40f-140f" rel="noopener" class="underline">USDA Food Safety and Inspection Service, &ldquo;&lsquo;Danger Zone&rsquo; (40 &deg;F &ndash; 140 &deg;F)&rdquo;</a>.
      </p>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Pairing Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/chocolate-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🍫
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Chocolate Pairing</h4>
            <p class="text-sm text-[var(--text-muted)]">Sweet combinations</p>
          </div>
        </a>

        <a href="/tools/cheese-board-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🧀
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Cheese Board Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Calculate quantities</p>
          </div>
        </a>

        <a href="/tools/flavor-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-pink-100 flex items-center justify-center text-pink-700">
            ✨
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Flavor Pairing Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Discover flavor combos</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cheese & Accompaniment Matcher",
  "description": "Find perfect wine, fruit, nut, and charcuterie pairings for 16 popular cheeses. Build the ultimate cheese board with expert pairing recommendations.",
  "url": "https://pairdish.com/tools/cheese-pairing",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
