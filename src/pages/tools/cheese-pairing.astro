---
/**
 * Cheese & Accompaniment Matcher Tool Page
 *
 * Find perfect pairings for any cheese type.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import CheesePairing from '../../components/tools/CheesePairing';
---

<BaseLayout
  title="Cheese & Accompaniment Matcher"
  description="Find perfect wine, fruit, nut, and charcuterie pairings for 16 popular cheeses. Build the ultimate cheese board with expert pairing recommendations."
  keywords={['cheese pairing', 'cheese board ideas', 'wine and cheese pairing', 'cheese accompaniments', 'cheese platter', 'brie pairing', 'cheddar pairing', 'blue cheese pairing']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Cheese & Accompaniment Matcher', url: '/tools/cheese-pairing' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Cheese Pairing</span>
        </nav>

        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Cheese & <span class="text-accent text-[var(--color-wine)]">Accompaniment Matcher</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Discover the perfect wines, fruits, nuts, and more to pair with your favorite cheeses.
          Build an unforgettable cheese board with our expert recommendations.
        </p>
      </div>
    </div>
  </section>

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <CheesePairing client:load />
    </div>
  </section>

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />

      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          The Art of Cheese Pairing
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Match Intensity
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Pair mild cheeses with delicate accompaniments and bold cheeses with assertive partners.
              A subtle Brie pairs well with mild honey, while pungent Roquefort stands up to
              strong port wine.
            </p>
          </div>

          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              Balance Sweet & Savory
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Sweet accompaniments like honey, jam, and dried fruits contrast beautifully with
              salty or pungent cheeses. This contrast creates complexity and keeps your
              palate interested.
            </p>
          </div>
        </div>

        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Classic Cheese Categories
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block font-bold text-amber-700 text-sm">Soft</span>
            <span class="block text-xs text-amber-600 mt-1">Brie, Camembert, Burrata</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block font-bold text-orange-700 text-sm">Hard</span>
            <span class="block text-xs text-orange-600 mt-1">Cheddar, Parmesan, Pecorino</span>
          </div>
          <div class="text-center p-4 bg-blue-50 rounded-lg">
            <span class="block font-bold text-blue-700 text-sm">Blue</span>
            <span class="block text-xs text-blue-600 mt-1">Gorgonzola, Roquefort, Stilton</span>
          </div>
        </div>


      </article>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Pairing Tools
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/chocolate-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🍫
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Chocolate Pairing</h4>
            <p class="text-sm text-[var(--text-muted)]">Sweet combinations</p>
          </div>
        </a>

        <a href="/tools/cheese-board-calculator" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🧀
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Cheese Board Calculator</h4>
            <p class="text-sm text-[var(--text-muted)]">Calculate quantities</p>
          </div>
        </a>

        <a href="/tools/flavor-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-pink-100 flex items-center justify-center text-pink-700">
            ✨
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Flavor Pairing Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Discover flavor combos</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .prose {
    color: var(--text-secondary);
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
