---
/**
 * Flavor Pairing Finder Tool Page
 *
 * Interactive tool for discovering food flavor pairings.
 */

import BaseLayout from '../../components/layouts/BaseLayout.astro';
import FlavorPairingFinder from '../../components/tools/FlavorPairingFinder';
import AdSense from '../../components/AdSense.astro';
---

<BaseLayout
  title="Flavor Pairing Finder"
  description="Discover scientifically-backed flavor combinations. Enter any ingredient to explore perfect pairings based on shared aromatic compounds."
  keywords={['flavor pairing', 'food pairing', 'ingredient matcher', 'what goes with', 'cooking combinations', 'recipe ideas']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools' },
    { name: 'Flavor Pairing Finder', url: '/tools/flavor-pairing' }
  ]}
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-[var(--color-parchment)] to-[var(--color-cream)]">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-sm text-[var(--text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-wine)] transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--color-wine)] transition-colors">Tools</a>
          <span>/</span>
          <span class="text-[var(--color-wine)]">Flavor Pairing</span>
        </nav>
        
        <!-- Title -->
        <h1 class="text-display text-[var(--text-primary)] mb-4">
          Flavor Pairing <span class="text-accent text-[var(--color-wine)]">Finder</span>
        </h1>
        
        <!-- Description -->
        <p class="text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
          Discover perfect flavor combinations backed by food science. 
          Enter any ingredient to explore classic pairings and surprising matches 
          based on shared aromatic compounds.
        </p>
      </div>
    </div>
  </section>

  <!-- Ad Unit -->
  <AdSense slot="0000000004" format="auto" className="my-8" />

  <!-- Tool Section -->
  <section class="py-12 md:py-16">
    <div class="container">
      <FlavorPairingFinder client:load />
    </div>
  </section>

  <!-- Ad Unit -->
  <AdSense slot="0000000005" format="auto" className="my-8" />

  <!-- Educational Content for SEO -->
  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <hr class="divider mb-12" />
      
      <article class="prose prose-lg">
        <h2 class="text-display text-2xl font-semibold text-[var(--text-primary)] mb-6">
          Understanding Flavor Pairing Science
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              What is Flavor Pairing?
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Flavor pairing is the practice of combining ingredients that share similar aromatic 
              compounds. Foods with overlapping flavor molecules often taste harmonious together, 
              creating balanced and satisfying dishes.
            </p>
          </div>
          
          <div class="bg-[var(--color-cream)] rounded-xl p-6">
            <h3 class="font-display text-xl font-semibold mb-3 text-[var(--text-primary)]">
              How Our Tool Works
            </h3>
            <p class="text-[var(--text-secondary)] text-base leading-relaxed">
              Our Flavor Pairing Finder analyzes ingredient profiles including aromatic compounds, 
              flavor notes, and cuisine traditions to suggest both classic combinations and 
              unexpected pairings that professional chefs use.
            </p>
          </div>
        </div>
        
        <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4">
          Popular Pairing Categories
        </h3>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          <div class="text-center p-4 bg-[var(--color-wine-glow)] rounded-lg">
            <span class="block text-2xl mb-2">🥩</span>
            <span class="text-sm font-medium text-[var(--color-wine)]">Proteins</span>
          </div>
          <div class="text-center p-4 bg-green-50 rounded-lg">
            <span class="block text-2xl mb-2">🥬</span>
            <span class="text-sm font-medium text-green-700">Vegetables</span>
          </div>
          <div class="text-center p-4 bg-amber-50 rounded-lg">
            <span class="block text-2xl mb-2">🌿</span>
            <span class="text-sm font-medium text-amber-700">Herbs & Spices</span>
          </div>
          <div class="text-center p-4 bg-orange-50 rounded-lg">
            <span class="block text-2xl mb-2">🍎</span>
            <span class="text-sm font-medium text-orange-700">Fruits</span>
          </div>
        </div>
        

              <h3 class="text-display text-xl font-semibold text-[var(--text-primary)] mb-4 mt-10">
          Flavour Pairing: The Same Science, The Other Spelling
        </h3>

        <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
          A search for a flavour pairing chart is really a search for what the tool above does &mdash;
          <em>flavour</em> is the British and Commonwealth spelling of the same word. Both spellings
          describe one idea: ingredients that share aromatic compounds tend to taste harmonious
          together, which is why basil suits tomato, dill suits salmon, and rosemary suits lamb.
        </p>

        <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
          If you are cooking from a British recipe book or a European menu, the workflow does not
          change. Pick the base ingredient in the finder, then compare the classic matches with the
          less obvious ones: the classics are the safe route, and the unusual matches are where a
          dish starts to feel deliberate.
        </p>

        <figure class="mb-10 overflow-x-auto rounded-2xl border border-[var(--color-cream-dark)] bg-white shadow-[var(--shadow-soft)]">
          <table class="w-full min-w-[560px] border-collapse text-left text-[var(--text-secondary)]">
            <caption class="px-4 pt-3 text-left text-sm font-medium text-[var(--text-muted)]">Classic pairings the finder returns for common base ingredients</caption>
            <thead>
              <tr class="bg-[var(--color-cream-soft)]">
                <th scope="col" class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Base ingredient</th>
                <th scope="col" class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Classic matches</th>
                <th scope="col" class="border-b border-[var(--color-cream-dark)] px-4 py-3 font-display text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)]">Why the combination works</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-white"><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Apples</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Cinnamon, sharp cheddar, pork</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Sweet-tart fruit against warm spice, salt, or rich fat</td></tr>
              <tr class="bg-[var(--color-cream)]"><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Tomatoes</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Basil, mozzarella, olive oil</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Green herb and savory notes balance the acidity</td></tr>
              <tr class="bg-white"><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Salmon</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Dill, lemon, capers</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Bright and salty accents cut the richness of oily fish</td></tr>
              <tr class="bg-[var(--color-cream)]"><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Mushrooms</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Thyme, garlic, soy sauce</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Earthy notes lifted by allium and fermented umami</td></tr>
              <tr class="bg-white"><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Chocolate</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Coffee, orange, chilli</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Roasted, citrus, and warm heat notes stack rather than clash</td></tr>
              <tr class="bg-[var(--color-cream)]"><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Lamb</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Rosemary, garlic, mint</td><td class="border-b border-[var(--color-cream-dark)] px-4 py-3 align-top">Resinous herb and allium standing up to a strong red meat</td></tr>
            </tbody>
          </table>
        </figure>

        <p class="text-[var(--text-secondary)] text-base leading-relaxed mb-6">
          Pair it with the
          <a href="/tools/herb-spice-matrix" class="text-[var(--color-wine)] underline">herb and spice matrix</a>
          when you want to swap seasonings, the
          <a href="/tools/seasonal-guide" class="text-[var(--color-wine)] underline">seasonal ingredient guide</a>
          to see what is at its best right now, or the
          <a href="/articles/what-to-serve-with-pesto-chicken" class="text-[var(--color-wine)] underline">pesto chicken pairing guide</a>
          to see pairing decisions turned into a full dinner.
        </p>

      </article>
    </div>
  </section>

  <!-- Ad Unit -->
  <AdSense slot="0000000006" format="auto" className="my-8" />

  <!-- Related Tools -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Tools
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/tools/substitution-finder" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center text-purple-700">
            🔄
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Substitution Finder</h4>
            <p class="text-sm text-[var(--text-muted)]">Ingredient alternatives</p>
          </div>
        </a>
        
        <a href="/tools/herb-spice-matrix" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            🌿
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Herb & Spice Matrix</h4>
            <p class="text-sm text-[var(--text-muted)]">Seasoning combinations</p>
          </div>
        </a>
        
        <a href="/tools/cheese-pairing" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-yellow-100 flex items-center justify-center text-yellow-700">
            🧀
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">Cheese Pairing</h4>
            <p class="text-sm text-[var(--text-muted)]">Cheese board builder</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="py-12 bg-[var(--color-cream)]">
    <div class="container">
      <h2 class="text-display text-xl font-semibold text-[var(--text-secondary)] mb-6 text-center">
        Related Guides
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/articles/what-to-serve-with-roasted-potatoes" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center text-amber-700">
            🥔
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">What to Serve with Roasted Potatoes</h4>
            <p class="text-sm text-[var(--text-muted)]">12 mains and sauces, with per-person portion math.</p>
          </div>
        </a>

        <a href="/articles/what-to-serve-with-fried-fish" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-sky-100 flex items-center justify-center text-sky-700">
            🐟
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">What to Serve with Fried Fish</h4>
            <p class="text-sm text-[var(--text-muted)]">Classic sides and the science behind tartar sauce.</p>
          </div>
        </a>

        <a href="/articles/what-to-serve-with-pesto-chicken" class="card bg-white hover:border-[var(--color-wine)] border border-transparent flex items-center gap-4 p-4">
          <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-700">
            🍗
          </div>
          <div>
            <h4 class="font-medium text-[var(--text-primary)]">What to Serve with Pesto Chicken</h4>
            <p class="text-sm text-[var(--text-muted)]">A Ligurian one-pot method for weeknights.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<!-- WebApplication Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Flavor Pairing Finder",
  "description": "Discover scientifically-backed flavor combinations. Enter any ingredient to explore perfect pairings based on shared aromatic compounds.",
  "url": "https://pairdish.com/tools/flavor-pairing",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isPartOf": { "@type": "WebSite", "name": "PairDish", "url": "https://pairdish.com/" }
})} />



<style>
  .prose {
    color: var(--text-secondary);
  }
  
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
